# Secrets
#
# `.env.template` is the committed one, and it holds placeholders only.
# Every other .env* file is local and stays local. Do not add a negation
# here: a local `.env.example` on this machine carries real subscription
# and tenant identifiers, and one re-ordered line would publish them.
.env
.env.*
!.env.template

# OS
.DS_Store

# Tooling
.deepeval/

# Build
dist/
.astro/
node_modules/

# Copied out of node_modules on every dev/build (scripts/vendor-timeline.mjs).
# package.json is the source of truth for the TimelineJS version, not this copy.
public/vendor/

# Playwright MCP scratch output
.playwright-mcp/

# Local working artefacts: a saved copy of the deployed page and screenshots
# taken while building. Useful locally, noise in a public repository.
live.html
*.screenshot.png
router.png

# Rejected generation attempts: local debugging output, regenerated on demand.
# The reviewed corpus and the manifest are committed; these are not.
content/learn/rejected/*.attempt-*.json
