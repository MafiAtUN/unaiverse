# Azure OpenAI — content generation only.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# These credentials are used by `scripts/learn/generate-terms.mjs` on a
# developer's machine (or a controlled CI job). They are NEVER read by the
# site: nothing under `src/` imports the Azure client, the published output is
# static JSON and HTML, and `npm test` asserts that no Azure identifier or
# `.env` value appears anywhere in `dist/`.
#
# Everything except these four is optional. The pipeline runs without any of
# them via `--dry-run` (prints prompts, calls nothing) or `--fixtures`.

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The *deployment* name from your Azure AI Foundry resource, not a model name.
# Deliberately configurable: this repository hardcodes no model anywhere.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# Retrieve real values for an existing resource with:
#   az account set --subscription <SUBSCRIPTION>
#   az cognitiveservices account keys list -n <RESOURCE> -g <RESOURCE_GROUP>
#   az cognitiveservices account deployment list -n <RESOURCE> -g <RESOURCE_GROUP> -o table
