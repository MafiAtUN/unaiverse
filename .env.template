# UNAIVERSE — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# ---------------------------------------------------------------------------
# Read this first: the site needs NONE of these.
# ---------------------------------------------------------------------------
#
#   npm install && npm run dev     works with no .env at all
#   npm run build                  works with no .env at all
#   npm test                       works with no .env at all
#   npm run content:validate       works with no .env at all
#   npm run content:report         works with no .env at all
#   npm run content:check-links    works with no .env at all
#
# Credentials are used only by the offline content pipeline, on a maintainer's
# machine, to write JSON to disk. They are never read by the site: nothing
# under `src/` imports the model client, the published output is static JSON
# and HTML, and `npm test` asserts that no Azure identifier and no value from
# your `.env` appears anywhere in `dist/`.
#
# So: if you are here to run, read or contribute to the website, close this
# file. You do not need it.
#
# Every generation script also accepts `--dry-run` (prints the prompt, calls
# nothing) and the test suite runs on fixtures, so you can work on the pipeline
# itself without any credential either.
#
# ===========================================================================
# 1. AZURE OPENAI — required by the content pipeline
# ===========================================================================
# Read by: scripts/learn/lib/config.mjs
# Used by: npm run content:generate, content:review, content:voice
#
# The resource hostname, with no path. Trailing slash optional.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/

# The API key for that resource. Either of the two Azure keys works.
AZURE_OPENAI_API_KEY=

# The *deployment* name from your Azure AI Foundry resource, not a model name.
# Deliberately configurable: this repository hardcodes no model anywhere, so it
# does not go stale when a model family is retired.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional. Defaults to 2024-10-21 when unset.
AZURE_OPENAI_API_VERSION=2024-10-21

# ===========================================================================
# 2. OPTIONAL — a second deployment for the reviewer and the voice pass
# ===========================================================================
# Read by: scripts/learn/review-terms.mjs, scripts/learn/un-voice.mjs
#
# The review pass is worth more when the reviewer is not the writer. If these
# are unset, both fall back to AZURE_OPENAI_DEPLOYMENT above and the pipeline
# still runs, it just marks its own homework. Command-line flags
# (`--reviewer <name>`, `--model <name>`) beat both.
#
# Precedence, first match wins:
#   review-terms.mjs  --reviewer → GPT56_SOL → GPT55 → AZURE_OPENAI_DEPLOYMENT
#   un-voice.mjs      --model    → GPT56_SOL         → AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_DEPLOYMENT_GPT56_SOL=
AZURE_OPENAI_DEPLOYMENT_GPT55=

# ===========================================================================
# 3. OPTIONAL — the persona takes generator
# ===========================================================================
# Read by: scripts/generate-takes.mjs (npm run takes)
#
# This one script predates the pipeline in scripts/learn/ and takes a full
# base URL rather than a bare hostname. Note the `/openai/v1` suffix: it is
# the OpenAI-shaped route on the same Azure resource, so this is the same
# host as AZURE_OPENAI_ENDPOINT above with a path on the end.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1

# ===========================================================================
# 4. OPTIONAL — regenerating the social card
# ===========================================================================
# Read by: scripts/make-og.mjs (npm run og)
#
# Only needed when running the script from outside the repository root, which
# is how you run it against a global Playwright install. Playwright is
# deliberately not a project dependency: public/og.png is committed, so CI
# never needs a browser to build the site.
# OG_ROOT=/absolute/path/to/this/repository

# ===========================================================================
# 5. Other model providers
# ===========================================================================
# Not supported today, and these names are listed so you know what is missing
# rather than to imply they work. This repository calls Azure OpenAI only, and
# authenticates with the Azure-specific `api-key` header rather than a bearer
# token, so an OpenAI or Anthropic key dropped in here would be ignored.
#
# Adding a provider is a small, self-contained change: the HTTP call lives in
# scripts/learn/lib/azure.mjs and the configuration in
# scripts/learn/lib/config.mjs. Nothing else in the repository knows which
# model wrote a term, and the published site cannot tell either. A pull
# request that generalises those two files is welcome, see CONTRIBUTING.md.
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ===========================================================================
# Retrieving real values for an existing Azure resource
# ===========================================================================
#   az account set --subscription <SUBSCRIPTION>
#   az cognitiveservices account keys list -n <RESOURCE> -g <RESOURCE_GROUP>
#   az cognitiveservices account deployment list -n <RESOURCE> -g <RESOURCE_GROUP> -o table
#
# Never paste a real endpoint, subscription id, tenant id or resource group
# into this template. It is committed. `.env` is not.
