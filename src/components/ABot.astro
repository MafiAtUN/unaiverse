---
/**
 * A/BOT — the robot guide (plan §6).
 * Phase 5 gives it the scripted dialogue tree, glossary mode and mini-quests.
 * This is the shell: it exists, it is reachable by keyboard, and it says
 * something honest about where it is in its own development.
 */
import { SITE } from '../lib/taxonomy';
---

<div class="abot" id="abot">
  <button
    class="abot__button"
    type="button"
    aria-expanded="false"
    aria-controls="abot-panel"
    data-abot-toggle
  >
    <span class="abot__face" aria-hidden="true">🤖</span>
    <span class="visually-hidden">Open {SITE.bot}, the guide</span>
  </button>

  <div class="abot__panel" id="abot-panel" hidden data-abot-panel>
    <p class="abot__name">{SITE.bot}</p>
    <p class="abot__line">
      Bureaucratic Explainer &amp; Educational Protocol droid. I explain AI governance
      through <em>Star Wars</em>, Asimov and the occasional dragon.
    </p>
    <p class="abot__line abot__line--status">
      My dialogue tree lands in Phase 5. Right now I mostly just float here
      looking approachable — which, to be fair, is most of the job.
    </p>
  </div>
</div>

<style>
  .abot {
    position: fixed;
    right: var(--sp-4);
    bottom: var(--sp-4);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-3);
  }

  .abot__button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid rgb(255 107 74 / 0.5);
    background: var(--void-panel);
    box-shadow: 0 6px 24px rgb(7 11 26 / 0.7);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform var(--dur) var(--ease);
  }

  .abot__button:hover {
    transform: translateY(-2px);
  }

  .abot__face {
    animation: abot-bob 5s ease-in-out infinite;
  }

  @keyframes abot-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .abot__panel {
    order: -1;
    width: min(20rem, calc(100vw - 2rem));
    padding: var(--sp-4);
    border: 1px solid rgb(255 107 74 / 0.35);
    border-radius: var(--radius);
    background: var(--void-panel);
    box-shadow: 0 10px 40px rgb(7 11 26 / 0.8);
  }

  .abot__panel[hidden] {
    display: none;
  }

  .abot__name {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--signal);
  }

  .abot__line {
    margin: 0 0 var(--sp-3);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .abot__line--status {
    margin-bottom: 0;
    color: var(--ink-faint);
    font-style: italic;
  }

  @media (max-width: 40rem) {
    .abot {
      right: var(--sp-3);
      bottom: var(--sp-3);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-abot-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-abot-panel]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    panel!.hidden = open;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      panel!.hidden = true;
      toggle.focus();
    }
  });
</script>
