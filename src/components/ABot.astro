---
/**
 * A/BOT — the robot guide (plan §6).
 *
 * Scripted, not a live model: the whole personality is `src/data/abot.json`,
 * which keeps the site static, fast and free. Three modes — glossary, quests,
 * and a pointer at real AI for anyone who wants to interrogate the material
 * properly.
 *
 * Hidden until its script runs. An inert robot button is worse than no robot.
 */
import abot from '../data/abot.json';
import { GLOSSARY } from '../lib/glossary';
import { getCollection } from 'astro:content';
import { glossaryTermMap } from '../lib/learn/timeline';
import { learnHref } from '../lib/learn/terms';

/**
 * The portal to the literacy half of the site.
 *
 * A/BOT keeps its own two-line definition and its analogy — that voice is the
 * point, and replacing it with a 2,000-word page would be a worse timeline.
 * What changes is that a term with a full page now offers a way through to it,
 * and only a term that actually has one. Everything else behaves exactly as
 * before, so no existing glossary link breaks.
 */
const LEARN_LINKS = glossaryTermMap();
const LEARN_BASE = learnHref();

const milestones = await getCollection('milestones');
const titleById = new Map(milestones.map((m) => [m.id, m.data.title]));

// A quest step pointing at a milestone that no longer exists would be a dead
// link in the UI. Catch it at build time instead.
const quests = abot.quests.map((q) => ({
  ...q,
  steps: q.steps
    .map((s) => ({ ...s, title: titleById.get(s.milestone) }))
    .filter((s) => {
      if (!s.title) console.warn(`[unaiverse] A/BOT quest "${q.id}" → unknown milestone "${s.milestone}"`);
      return !!s.title;
    }),
}));
---

<aside class="abot" aria-label="A/BOT, your guide" data-abot hidden>
  <div class="abot__panel on-paper" id="abot-panel" hidden data-abot-panel>
    <header class="abot__head">
      <div>
        <p class="abot__badge mono">{abot.intro.name}</p>
        <p class="abot__expansion">{abot.intro.expansion}</p>
      </div>
      <button type="button" class="abot__close" data-abot-close aria-label="Close A/BOT">×</button>
    </header>

    <div class="abot__tabs" role="tablist" aria-label="A/BOT modes">
      <button type="button" role="tab" class="abot__tab" data-abot-mode="glossary" aria-selected="true">
        Glossary
      </button>
      <button type="button" role="tab" class="abot__tab" data-abot-mode="quests" aria-selected="false">
        Quests
      </button>
      <button type="button" role="tab" class="abot__tab" data-abot-mode="real" aria-selected="false">
        Real AI
      </button>
    </div>

    <div class="abot__body" data-abot-body>
      {/* ── Glossary ─────────────────────────────────────────────── */}
      <section class="abot__mode" data-abot-panel-for="glossary">
        <p class="abot__hint" data-abot-glossary-hint>
          Tap any <span class="abot__hint-term">underlined term</span> in the timeline and I will explain
          it here. Or browse all {GLOSSARY.length}:
        </p>

        <div class="abot__entry" data-abot-entry hidden>
          <h4 class="abot__entry-term" data-abot-entry-term></h4>
          <p class="abot__entry-short" data-abot-entry-short></p>
          <p class="abot__entry-analogy">
            <span class="abot__analogy-mark">Think of it as</span>
            <span data-abot-entry-analogy></span>
          </p>
          <a class="abot__entry-more" data-abot-entry-more hidden href={LEARN_BASE}>
            Learn this concept fully
            <span class="abot__entry-more-hint">
              analogy, visual, worked example, UN example, quick check
            </span>
          </a>
        </div>

        <ul class="abot__terms" data-abot-terms>
          {
            GLOSSARY.map((g) => (
              <li>
                <button
                  type="button"
                  class="abot__term-chip"
                  data-abot-open-term={g.slug}
                  data-has-page={LEARN_LINKS[g.slug] ? '' : undefined}
                >
                  {g.term}
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      {/* ── Quests ───────────────────────────────────────────────── */}
      <section class="abot__mode" data-abot-panel-for="quests" hidden>
        <p class="abot__hint">
          Short guided routes through the timeline. Pick your situation, and each stop opens the node
          and tells you why it is on the list.
        </p>
        {
          quests.map((q) => (
            <details class="quest">
              <summary class="quest__summary">
                <span class="quest__glyph" aria-hidden="true">
                  {q.glyph}
                </span>
                <span>
                  <span class="quest__title">{q.title}</span>
                  <span class="quest__blurb">{q.blurb}</span>
                </span>
                <span class="quest__count mono">{q.steps.length}</span>
              </summary>
              <ol class="quest__steps">
                {q.steps.map((s) => (
                  <li>
                    <button type="button" class="quest__step" data-abot-goto={s.milestone}>
                      <span class="quest__step-title">{s.title}</span>
                      <span class="quest__step-why">{s.why}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </details>
          ))
        }
      </section>

      {/* ── Real AI ──────────────────────────────────────────────── */}
      <section class="abot__mode" data-abot-panel-for="real" hidden>
        <h4 class="abot__real-heading">{abot.realAI.heading}</h4>
        <p class="abot__hint">{abot.realAI.intro}</p>
        <ul class="abot__prompts">
          {
            abot.realAI.prompts.map((prompt) => (
              <li>
                <button type="button" class="abot__prompt" data-abot-copy={prompt}>
                  <span>{prompt}</span>
                  <span class="abot__copy-hint mono">copy</span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="abot__caveat">{abot.realAI.caveat}</p>
      </section>
    </div>

    <footer class="abot__foot">
      <p class="abot__fact" data-abot-fact></p>
      <button type="button" class="abot__fact-next" data-abot-fact-next>Another</button>
    </footer>
  </div>

  <button
    class="abot__button"
    type="button"
    aria-expanded="false"
    aria-controls="abot-panel"
    data-abot-toggle
  >
    <span class="abot__face" aria-hidden="true">🤖</span>
    <span class="visually-hidden">Open {abot.intro.name}, your guide</span>
  </button>
</aside>

<script
  is:inline
  define:vars={{ GLOSSARY_DATA: GLOSSARY, FACTS: abot.facts, LEARN: LEARN_LINKS, LEARN_BASE }}
>
  window.__ABOT__ = { glossary: GLOSSARY_DATA, facts: FACTS, learn: LEARN, learnBase: LEARN_BASE };
</script>

<style>
  .abot {
    position: fixed;
    right: var(--sp-4);
    bottom: var(--sp-4);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-3);
  }

  .abot[hidden] {
    display: none;
  }

  .abot__button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid rgb(255 95 168 / 0.55);
    background: var(--void-panel);
    box-shadow: 0 8px 28px rgb(6 6 7 / 0.85);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform var(--dur) var(--ease-out);
  }

  .abot__button:hover {
    transform: translateY(-3px) scale(1.04);
  }

  .abot__face {
    animation: abot-bob 5s ease-in-out infinite;
  }

  @keyframes abot-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .abot__panel {
    display: flex;
    flex-direction: column;
    width: min(26rem, calc(100vw - 2rem));
    max-height: min(38rem, calc(100vh - 7rem));
    border-radius: var(--radius);
    border-top: 3px solid var(--pink-on-paper);
    box-shadow: var(--shadow-panel);
    animation: abot-in var(--dur) var(--ease-out);
    overflow: hidden;
  }

  .abot__panel[hidden] {
    display: none;
  }

  @keyframes abot-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .abot__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-4) var(--sp-3);
  }

  .abot__badge {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--pink-on-paper);
  }

  .abot__expansion {
    margin: 0;
    max-width: none;
    font-size: var(--step--2);
    /* --paper-ink-faint is under 4.5:1 at this size; dim clears it at 7.6:1 */
    color: var(--paper-ink-dim);
  }

  .abot__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--paper-hairline);
    border-radius: 50%;
    background: none;
    color: var(--paper-ink-dim);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .abot__close:hover {
    background: var(--paper-sunk);
    color: var(--paper-ink);
  }

  .abot__tabs {
    display: flex;
    gap: var(--sp-1);
    padding: 0 var(--sp-4);
    border-bottom: 1px solid var(--paper-hairline);
  }

  .abot__tab {
    padding: var(--sp-2) var(--sp-3);
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: inherit;
    font-size: var(--step--1);
    color: var(--paper-ink-dim);
    cursor: pointer;
  }

  .abot__tab:hover {
    color: var(--paper-ink);
  }

  .abot__tab[aria-selected='true'] {
    color: var(--paper-ink);
    font-weight: 600;
    border-bottom-color: var(--pink-on-paper);
  }

  .abot__body {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-4);
  }

  .abot__mode[hidden] {
    display: none;
  }

  .abot__hint {
    margin: 0 0 var(--sp-3);
    max-width: none;
    font-size: var(--step--1);
    color: var(--paper-ink-dim);
  }

  .abot__hint-term {
    text-decoration: underline dotted;
    text-decoration-color: var(--pink-on-paper);
    text-underline-offset: 3px;
  }

  /* ── Glossary entry ───────────────────────────────────────────── */
  .abot__entry {
    margin-bottom: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-left: 3px solid var(--pink-on-paper);
    background: var(--paper-sunk);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .abot__entry[hidden] {
    display: none;
  }

  .abot__entry-term {
    margin: 0 0 var(--sp-2);
    font-size: var(--step-0);
    color: var(--paper-ink);
  }

  .abot__entry-short {
    margin: 0 0 var(--sp-3);
    max-width: none;
    font-size: var(--step--1);
    color: var(--paper-ink);
  }

  /* The door through to the full page. Present only when there is one, so it
     never promises a page that does not exist. */
  .abot__entry-more {
    display: block;
    margin-top: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--paper-hairline-strong);
    border-left: 3px solid var(--pink-on-paper);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    color: var(--pink-on-paper);
  }

  .abot__entry-more[hidden] {
    display: none;
  }

  .abot__entry-more:hover {
    background: var(--paper-sunk);
    color: var(--paper-ink);
  }

  .abot__entry-more-hint {
    display: block;
    font-weight: 400;
    font-size: var(--step--2);
    color: var(--paper-ink-faint);
    margin-top: 0.15rem;
  }

  /* A glossary chip that leads somewhere says so, with a mark rather than
     colour alone. */
  .abot__term-chip[data-has-page]::after {
    content: ' →';
    color: var(--pink-on-paper);
  }

  .abot__entry-analogy {
    margin: 0;
    max-width: none;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--paper-ink-dim);
  }

  .abot__analogy-mark {
    display: block;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pink-on-paper);
  }

  .abot__terms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .abot__term-chip {
    padding: 0.25em 0.7em;
    border: 1px solid var(--paper-hairline);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: var(--step--2);
    color: var(--paper-ink-dim);
    cursor: pointer;
  }

  .abot__term-chip:hover,
  .abot__term-chip[aria-current='true'] {
    border-color: var(--pink-on-paper);
    background: var(--paper-sunk);
    color: var(--paper-ink);
  }

  /* ── Quests ───────────────────────────────────────────────────── */
  .quest {
    border: 1px solid var(--paper-hairline);
    border-radius: var(--radius-sm);
    margin-bottom: var(--sp-2);
  }

  .quest__summary {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-3);
    cursor: pointer;
    list-style: none;
  }

  .quest__summary::-webkit-details-marker {
    display: none;
  }

  .quest__glyph {
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .quest__title {
    display: block;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--paper-ink);
  }

  .quest__blurb {
    display: block;
    font-size: var(--step--2);
    color: var(--paper-ink-faint);
  }

  .quest__count {
    margin-left: auto;
    flex: none;
    font-size: var(--step--2);
    color: var(--paper-ink-faint);
  }

  .quest__steps {
    margin: 0;
    padding: 0 var(--sp-3) var(--sp-3) var(--sp-6);
    display: grid;
    gap: var(--sp-2);
  }

  .quest__steps li::marker {
    color: var(--pink-on-paper);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .quest__step {
    display: block;
    width: 100%;
    padding: var(--sp-2);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .quest__step:hover {
    background: var(--paper-sunk);
  }

  .quest__step-title {
    display: block;
    font-size: var(--step--1);
    color: var(--pink-on-paper);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .quest__step-why {
    display: block;
    font-size: var(--step--2);
    color: var(--paper-ink-faint);
  }

  /* ── Real AI ──────────────────────────────────────────────────── */
  .abot__real-heading {
    margin: 0 0 var(--sp-2);
    font-size: var(--step-0);
    color: var(--paper-ink);
  }

  .abot__prompts {
    margin: 0 0 var(--sp-3);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-2);
  }

  .abot__prompt {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    width: 100%;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--paper-hairline);
    border-radius: var(--radius-sm);
    background: var(--paper-sunk);
    font: inherit;
    font-size: var(--step--2);
    color: var(--paper-ink);
    text-align: left;
    cursor: pointer;
  }

  .abot__prompt:hover {
    border-color: var(--pink-on-paper);
  }

  .abot__copy-hint {
    margin-left: auto;
    flex: none;
    color: var(--pink-on-paper);
    font-size: var(--step--2);
  }

  .abot__caveat {
    margin: 0;
    max-width: none;
    font-size: var(--step--2);
    font-style: italic;
    color: var(--paper-ink-faint);
  }

  /* ── Footer fact ──────────────────────────────────────────────── */
  .abot__foot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--paper-hairline);
    background: var(--paper-sunk);
  }

  .abot__fact {
    margin: 0;
    max-width: none;
    font-size: var(--step--2);
    font-style: italic;
    color: var(--paper-ink-dim);
  }

  .abot__fact-next {
    margin-left: auto;
    flex: none;
    padding: 0.2em 0.6em;
    border: 1px solid var(--paper-hairline);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: var(--step--2);
    /* on --paper-sunk, faint falls under 4.5:1 at this size */
    color: var(--paper-ink-dim);
    cursor: pointer;
  }

  .abot__fact-next:hover {
    border-color: var(--pink-on-paper);
    color: var(--pink-on-paper);
  }

  /* Anchored to the right edge only — never stretched with left+right.
     A fixed element's containing block is the layout viewport, which on a
     phone can be wider than the visible page; stretching it pushed the
     button clean off the screen and made A/BOT untappable below 768px. */
  @media (max-width: 40rem) {
    .abot {
      right: var(--sp-3);
      bottom: var(--sp-3);
    }

    .abot__panel {
      width: min(23rem, calc(100dvw - 1.5rem));
      max-height: min(32rem, calc(100dvh - 6rem));
    }
  }
</style>

<script>
  interface Entry {
    term: string;
    short: string;
    analogy: string;
    slug: string;
  }

  const root = document.querySelector<HTMLElement>('[data-abot]');
  if (root) {
    root.hidden = false; // only now that the panel can actually open
    // Lets the glossary terms out in the prose show their underline. Until
    // this runs they are indistinguishable from ordinary text, so nobody
    // clicks a definition that cannot open.
    document.documentElement.classList.add('abot-ready');

    const data = (window as any).__ABOT__ as {
      glossary: Entry[];
      facts: string[];
      learn: Record<string, string>;
      learnBase: string;
    };
    const bySlug = new Map(data.glossary.map((g) => [g.slug, g]));

    const toggle = root.querySelector<HTMLButtonElement>('[data-abot-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-abot-panel]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-abot-close]')!;
    const body = root.querySelector<HTMLElement>('[data-abot-body]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-abot-mode]'));
    const modes = Array.from(root.querySelectorAll<HTMLElement>('[data-abot-panel-for]'));

    const entryBox = root.querySelector<HTMLElement>('[data-abot-entry]')!;
    const entryTerm = root.querySelector<HTMLElement>('[data-abot-entry-term]')!;
    const entryShort = root.querySelector<HTMLElement>('[data-abot-entry-short]')!;
    const entryAnalogy = root.querySelector<HTMLElement>('[data-abot-entry-analogy]')!;
    const entryMore = root.querySelector<HTMLAnchorElement>('[data-abot-entry-more]')!;
    const factEl = root.querySelector<HTMLElement>('[data-abot-fact]')!;

    let lastFocus: HTMLElement | null = null;

    function setOpen(open: boolean, returnFocus = false) {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) {
        nextFact();
      } else if (returnFocus) {
        (lastFocus ?? toggle).focus();
        lastFocus = null;
      }
    }

    function setMode(mode: string) {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.abotMode === mode)));
      modes.forEach((m) => (m.hidden = m.dataset.abotPanelFor !== mode));
      body.scrollTop = 0;
    }

    function showTerm(slug: string) {
      const entry = bySlug.get(slug);
      if (!entry) return;
      setMode('glossary');
      entryTerm.textContent = entry.term;
      entryShort.textContent = entry.short;
      entryAnalogy.textContent = entry.analogy;

      // Only offer the door if there is a room behind it.
      const learnId = data.learn?.[slug];
      if (learnId) {
        // Carry the milestone the reader came from, so the term page can send
        // them back to the exact node rather than to the top of the timeline.
        const from = lastFocus?.closest<HTMLElement>('[data-node]')?.id;
        entryMore.href =
          `${data.learnBase}/${learnId}`.replace(/\/+/g, '/') + (from ? `?from=${encodeURIComponent(from)}` : '');
        entryMore.hidden = false;
      } else {
        entryMore.hidden = true;
      }

      entryBox.hidden = false;
      // Hoisted function declaration, so the `if (root)` guard above does not
      // narrow here even though it cannot be called before it.
      root!
        .querySelectorAll<HTMLElement>('[data-abot-open-term]')
        .forEach((c) =>
          c.setAttribute('aria-current', String(c.dataset.abotOpenTerm === slug)),
        );
      body.scrollTop = 0;
    }

    let factIndex = Math.floor(Math.random() * data.facts.length);
    function nextFact() {
      factEl.textContent = data.facts[factIndex % data.facts.length]!;
      factIndex++;
    }

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    closeBtn.addEventListener('click', () => setOpen(false, true));
    tabs.forEach((t) => t.addEventListener('click', () => setMode(t.dataset.abotMode!)));
    root
      .querySelector('[data-abot-fact-next]')!
      .addEventListener('click', () => nextFact());

    root.querySelectorAll<HTMLButtonElement>('[data-abot-open-term]').forEach((chip) =>
      chip.addEventListener('click', () => showTerm(chip.dataset.abotOpenTerm!)),
    );

    // Glossary terms live out in the timeline prose, added at build time.
    document.addEventListener('click', (e) => {
      const term = (e.target as HTMLElement).closest<HTMLElement>('.term[data-term]');
      if (!term) return;
      lastFocus = term;
      document
        .querySelectorAll('.term[aria-current]')
        .forEach((t) => t.removeAttribute('aria-current'));
      term.setAttribute('aria-current', 'true');
      setOpen(true);
      showTerm(term.dataset.term!);
    });

    // Quest steps: open the node, scroll to it, and leave it focused.
    root.querySelectorAll<HTMLButtonElement>('[data-abot-goto]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const node = document.getElementById(btn.dataset.abotGoto!);
        if (!node) return;
        node.hidden = false;
        node.querySelector('details')?.setAttribute('open', '');
        node.classList.add('is-revealed');
        setOpen(false);
        node.scrollIntoView({ behavior: 'smooth', block: 'start' });
        node.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
      }),
    );

    // Copy a suggested prompt for a real model.
    root.querySelectorAll<HTMLButtonElement>('[data-abot-copy]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const hint = btn.querySelector('.abot__copy-hint')!;
        try {
          await navigator.clipboard.writeText(btn.dataset.abotCopy!);
          hint.textContent = 'copied';
        } catch {
          hint.textContent = 'select & copy';
        }
        setTimeout(() => (hint.textContent = 'copy'), 1800);
      }),
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false, true);
      }
    });

    document.addEventListener('click', (e) => {
      if (
        toggle.getAttribute('aria-expanded') === 'true' &&
        !root.contains(e.target as Node) &&
        !(e.target as HTMLElement).closest('.term[data-term]')
      ) {
        setOpen(false);
      }
    });
  }
</script>
