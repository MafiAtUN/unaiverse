---
/**
 * Typo-tolerant term search.
 *
 * The index is a separate JSON file fetched on first interaction, not inlined:
 * 300 terms of search metadata is real weight, and someone who lands on a term
 * page to read one definition should not pay for it. Scoring lives in
 * `src/lib/learn/search.ts` so the same code is unit-tested.
 *
 * Accessibility follows the combobox pattern: the input owns the listbox, the
 * active option is announced via aria-activedescendant, and the result count
 * is announced politely so a screen-reader user hears the list change without
 * losing their place in the field.
 */
import { learnHref } from '../../lib/learn/terms';

interface Props {
  variant?: 'panel' | 'inline';
  id: string;
  label: string;
  placeholder?: string;
  compact?: boolean;
  autofocus?: boolean;
}

const {
  variant = 'inline',
  id,
  label,
  placeholder = 'Try “LLM”, “hallucination”, “gradient decent”…',
  compact = false,
  autofocus = false,
} = Astro.props;

const listId = `${id}-results`;
const statusId = `${id}-status`;
const indexUrl = `${import.meta.env.BASE_URL}/learn/search.json`.replace(/\/+/g, '/');
---

<div
  class:list={['tsearch', `tsearch--${variant}`, { 'tsearch--hero': !compact }]}
  data-tsearch
  data-index={indexUrl}
  data-term-base={learnHref()}
>
  <div class="tsearch__field" role="search">
    <span class="tsearch__glyph" aria-hidden="true">⌕</span>
    <input
      class="tsearch__input"
      type="search"
      id={id}
      role="combobox"
      aria-expanded="false"
      aria-controls={listId}
      aria-autocomplete="list"
      aria-label={label}
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      autofocus={autofocus || undefined}
      data-tsearch-input
    />
    <button type="button" class="tsearch__clear" data-tsearch-clear hidden aria-label="Clear search"
      >×</button
    >
  </div>

  <p class="tsearch__status visually-hidden" id={statusId} role="status" aria-live="polite" data-tsearch-status></p>

  <ul class="tsearch__results" id={listId} role="listbox" aria-label="Search results" data-tsearch-results></ul>

  {
    !compact && (
      <p class="tsearch__status" data-tsearch-hint>
        Spelling does not have to be right. Acronyms work. So does describing it: “memory limit”
        finds the context window.
      </p>
    )
  }
</div>

<script>
  import { search, type SearchEntry, type SearchHit } from '../../lib/learn/search';

  const DIFFICULTY_LABEL: Record<string, string> = {
    starter: 'Starter',
    intermediate: 'Intermediate',
    deeper: 'Deeper',
  };

  /** One fetch per page, shared by every search box on it. */
  let indexPromise: Promise<SearchEntry[]> | null = null;
  function loadIndex(url: string): Promise<SearchEntry[]> {
    indexPromise ??= fetch(url)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .catch(() => [] as SearchEntry[]);
    return indexPromise;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-tsearch]')) {
    const input = root.querySelector<HTMLInputElement>('[data-tsearch-input]')!;
    const list = root.querySelector<HTMLUListElement>('[data-tsearch-results]')!;
    const status = root.querySelector<HTMLElement>('[data-tsearch-status]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-tsearch-clear]')!;
    const hint = root.querySelector<HTMLElement>('[data-tsearch-hint]');
    const indexUrl = root.dataset.index!;
    const base = root.dataset.termBase!;

    let entries: SearchEntry[] = [];
    let hits: SearchHit[] = [];
    let active = -1;

    const prime = () => {
      loadIndex(indexUrl).then((data) => {
        entries = data;
        if (input.value.trim()) render(input.value);
      });
    };
    input.addEventListener('focus', prime, { once: true });
    // A slow index fetch behind a fast typist is a blank list, so warm it as
    // soon as the browser is otherwise idle.
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(prime, { timeout: 4000 });
    }

    function optionId(i: number) {
      return `${input.id}-opt-${i}`;
    }

    function render(query: string) {
      const q = query.trim();
      clear.hidden = !q;
      if (!q) {
        list.replaceChildren();
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        status.textContent = '';
        if (hint) hint.hidden = false;
        return;
      }

      hits = search(q, entries, 20);
      active = -1;
      input.setAttribute('aria-expanded', String(hits.length > 0));
      input.removeAttribute('aria-activedescendant');
      if (hint) hint.hidden = true;

      if (!hits.length) {
        list.replaceChildren(emptyState(q));
        status.textContent = `No terms match “${q}”.`;
        return;
      }

      const frag = document.createDocumentFragment();
      hits.forEach((hit, i) => frag.append(renderHit(hit, i)));
      list.replaceChildren(frag);
      status.textContent = `${hits.length} term${hits.length === 1 ? '' : 's'} match “${q}”. Use the arrow keys to review them.`;
    }

    function emptyState(q: string) {
      const li = document.createElement('li');
      li.className = 'tsearch__empty';
      li.textContent = `Nothing matches “${q}”. Try a shorter word, or browse the A–Z index.`;
      return li;
    }

    function renderHit(hit: SearchHit, i: number) {
      const li = document.createElement('li');
      li.setAttribute('role', 'presentation');

      const a = document.createElement('a');
      a.className = 'tcard';
      a.href = `${base}/${hit.entry.i}`.replace(/\/+/g, '/');
      a.id = optionId(i);
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', 'false');

      const top = document.createElement('div');
      top.className = 'tcard__top';
      const term = document.createElement('p');
      term.className = 'tcard__term';
      term.textContent = hit.entry.t;
      const meta = document.createElement('span');
      meta.className = 'tcard__meta';
      meta.textContent = `${hit.entry.n} · ${DIFFICULTY_LABEL[hit.entry.d] ?? hit.entry.d}`;
      top.append(term, meta);

      const one = document.createElement('p');
      one.className = 'tcard__one';
      one.textContent = hit.entry.s;

      a.append(top, one);

      // Say why a result appeared when the match was not on the term itself —
      // otherwise "memory limit → Context window" looks like a bug.
      if (hit.matchedOn) {
        const why = document.createElement('p');
        why.className = 'tcard__matched';
        why.textContent = `matched on ${hit.matchedOn}`;
        a.append(why);
      }

      li.append(a);
      return li;
    }

    function setActive(next: number) {
      const options = list.querySelectorAll<HTMLAnchorElement>('[role="option"]');
      if (!options.length) return;
      active = (next + options.length) % options.length;
      options.forEach((el, i) => {
        el.setAttribute('aria-selected', String(i === active));
        el.classList.toggle('is-active', i === active);
      });
      const el = options[active]!;
      input.setAttribute('aria-activedescendant', el.id);
      el.scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (e) => {
      const options = list.querySelectorAll<HTMLAnchorElement>('[role="option"]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        // Enter with nothing highlighted opens the best match, which is what
        // someone who typed and hit return expects.
        const target = options[active >= 0 ? active : 0];
        if (target) {
          e.preventDefault();
          window.location.href = target.href;
        }
      } else if (e.key === 'Escape') {
        if (input.value) {
          e.preventDefault();
          input.value = '';
          render('');
        }
      }
    });

    clear.addEventListener('click', () => {
      input.value = '';
      render('');
      input.focus();
    });

    // The floating variant must get out of the way when attention moves on.
    if (root.classList.contains('tsearch--panel')) {
      document.addEventListener('click', (e) => {
        if (!root.contains(e.target as Node)) {
          list.replaceChildren();
          input.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // "/" focuses search from anywhere, the convention on reference sites.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement;
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return;
      if ((el as HTMLElement)?.isContentEditable) return;
      if (document.querySelector('[data-tsearch-input]') !== input) return; // first box only
      e.preventDefault();
      input.focus();
    });
  }
</script>
