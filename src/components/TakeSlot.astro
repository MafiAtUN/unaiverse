---
import { getTake } from '../lib/takes';
import { PERSONA_BY_ID } from '../lib/taxonomy';

interface Props {
  milestoneId: string;
  persona: string;
}

const { milestoneId, persona } = Astro.props;
const meta = PERSONA_BY_ID.get(persona);
const take = getTake(milestoneId, persona);

const BEATS = [
  { label: 'So what', value: take?.soWhat },
  { label: 'Watch for', value: take?.watchFor },
  { label: 'Use it', value: take?.useIt },
] as const;
---

<article class:list={['take', { 'take--pending': !take }]} data-persona={persona}>
  <header class="take__head">
    <span class="take__glyph" aria-hidden="true">{meta?.glyph ?? '•'}</span>
    <div>
      <h5 class="take__who">{meta?.label ?? persona}</h5>
      <p class="take__audience">{meta?.who}</p>
    </div>
  </header>

  {
    take ? (
      <dl class="take__beats">
        {BEATS.filter((b) => b.value).map((b) => (
          <div class="take__beat">
            <dt>{b.label}</dt>
            <dd>{b.value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="take__pending">
        <span class="take__pulse" aria-hidden="true" />
        <span>Take incoming — being written for this desk.</span>
      </p>
    )
  }
</article>

<style>
  .take {
    /* Capped so a ~60-word take reads as a card, not a stretched banner. */
    max-width: 52rem;
    padding: var(--sp-4);
    border: 1px solid var(--paper-hairline);
    border-left: 3px solid var(--blue-on-paper);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--paper-sunk);
  }

  .take__head {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--paper-hairline);
  }

  .take__glyph {
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .take__who {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--paper-ink);
  }

  .take__audience {
    margin: 0;
    font-size: var(--step--2);
    /* faint is 3.8:1 on --paper-sunk — fine for large text, under AA at 12px */
    color: var(--paper-ink-dim);
    max-width: none;
  }

  .take__beats {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .take__beat {
    display: grid;
    gap: var(--sp-1);
  }

  .take__beat dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-on-paper);
  }

  .take__beat dd {
    margin: 0;
    max-width: var(--measure-tight);
    color: var(--paper-ink);
  }

  /* Pending: calm and legible. It must read as "on its way", never as
     "broken" — this is the state 156 of 156 slots are in right now. */
  .take--pending {
    border-style: dashed;
    border-left-style: solid;
    border-left-color: var(--paper-hairline-strong);
    background: transparent;
  }

  .take--pending .take__head {
    border-bottom-color: transparent;
    padding-bottom: 0;
    margin-bottom: var(--sp-2);
    opacity: 0.7;
  }

  .take__pending {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: 0;
    color: var(--paper-ink-faint);
    font-size: var(--step--1);
    font-style: italic;
  }

  .take__pulse {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal-on-paper);
    opacity: 0.7;
    animation: take-pulse 2.4s var(--ease) infinite;
  }

  @keyframes take-pulse {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.85;
    }
  }
</style>
