---
import { parseMilestoneBody } from '../lib/milestone';
import { markupFactual } from '../lib/glossary';
import { buildBrief } from '../lib/brief';
import {
  BADGE_KIND,
  CONSTELLATIONS,
  ORGAN_BY_ID,
  TIERS,
  VENUE_BY_ID,
} from '../lib/taxonomy';
import RoleToggle from './RoleToggle.astro';

interface Props {
  id: string;
  data: {
    title: string;
    date_display: string;
    symbol: string | null;
    tier: 1 | 2 | 3;
    constellation: string;
    badges: string[];
    personas: string[];
    unverified: boolean;
    venue: string[];
    organ: string[];
    tldr?: string;
    quote?: { text: string; attribution: string; url?: string };
  };
  body: string;
}

const { id, data, body } = Astro.props;
const { factual, receipts, why } = parseMilestoneBody(body);
const tier = TIERS[data.tier];
const constellation = CONSTELLATIONS[data.constellation];

const venues = data.venue.map((v) => VENUE_BY_ID.get(v)).filter((v) => v !== undefined);
const organs = data.organ.map((o) => ORGAN_BY_ID.get(o)).filter((o) => o !== undefined);

// The static half of the briefing note. The client script bolts on whichever
// take is selected and copies the result — see the script at the foot of this
// file. Built here so the formatting lives in one place, in TypeScript.
const nodeUrl = new URL(
  `${import.meta.env.BASE_URL}/#${id}`.replace(/\/+/g, '/'),
  Astro.site,
).href;
const brief = buildBrief({
  id,
  title: data.title,
  dateDisplay: data.date_display,
  symbol: data.symbol,
  badges: data.badges,
  venue: data.venue,
  organ: data.organ,
  body,
  url: nodeUrl,
});

// The symbol without its separators, so a search for "79/325" or "79325"
// finds A/RES/79/325. Delegates type symbols from memory, rarely in full.
const searchBlob = [
  data.title,
  data.date_display,
  data.symbol ?? '',
  (data.symbol ?? '').replace(/[^A-Za-z0-9]/g, ''),
  ...venues.map((v) => v.label),
  ...organs.map((o) => o.label),
  ...data.badges,
]
  .join(' ')
  .toLowerCase();

// Supernovas open by default — they carry the narrative. Stars and Stardust
// stay closed so 76 nodes remain scannable in one scroll.
const openByDefault = data.tier === 1;

// Glossary terms become A/BOT buttons; *asterisks* become <em>. Done at build
// time over plain text, so no tag can be split (see lib/glossary.ts).
const { html: factualHtml } = markupFactual(factual);
---

<article
  class="node"
  id={id}
  data-tier={data.tier}
  data-constellation={data.constellation}
  data-venue={data.venue.join(' ')}
  data-organ={data.organ.join(' ')}
  data-search={searchBlob}
  data-node
>
  <div class="node__marker" aria-hidden="true">
    <span class="node__dot"></span>
  </div>

  <details class="node__shell" open={openByDefault}>
    <summary class="node__summary">
      <div class="node__meta">
        <time class="mono node__date">{data.date_display}</time>
        {data.symbol && <span class="mono node__symbol">{data.symbol}</span>}
      </div>

      <h3 class="node__title">{data.title}</h3>

      {data.tldr && <p class="node__tldr-teaser">{data.tldr}</p>}

      <div class="node__tags">
        <span class="tag tag--tier" data-tier-tag={data.tier}>
          <span aria-hidden="true">{tier.glyph}</span>
          {tier.name}
        </span>
        {
          constellation && (
            <span class="tag tag--constellation">
              <span aria-hidden="true">{constellation.glyph}</span>
              {constellation.label}
            </span>
          )
        }
        {
          data.badges.map((b) => (
            <span class="tag tag--badge" data-kind={BADGE_KIND[b] ?? 'process'}>
              {b}
            </span>
          ))
        }
        {
          venues.map((v) => (
            <span class="tag tag--venue" title={`Duty station: ${v.label}`}>
              {v.label}
            </span>
          ))
        }
        {
          organs.map((o) => (
            <span class="tag tag--organ">
              <span aria-hidden="true">{o.glyph}</span>
              {o.label}
            </span>
          ))
        }
        {
          data.personas.length > 0 && (
            <span class="tag tag--takes">
              {data.personas.length} take{data.personas.length === 1 ? '' : 's'}
            </span>
          )
        }
      </div>

      <span class="node__affordance" aria-hidden="true"></span>
    </summary>

    {/* The reading surface. Dark sky above, document below — plan §7 asks for
        long-form text on paper "so reading feels like documents, not terminals". */}
    <div class="node__paper on-paper on-paper--ruled">
      {
        data.tldr && (
          <p class="node__tldr">
            <span class="node__tldr-mark">Mafi's take</span>
            {data.tldr}
          </p>
        )
      }

      {
        data.quote && (
          <figure class="node__quote">
            <blockquote>{data.quote.text}</blockquote>
            <figcaption>
              {data.quote.url ? (
                <a href={data.quote.url} rel="noopener noreferrer" target="_blank">
                  {data.quote.attribution}
                </a>
              ) : (
                data.quote.attribution
              )}
            </figcaption>
          </figure>
        )
      }

      <div class="node__factual">
        <p set:html={factualHtml} />
      </div>

      {
        why && (
          <p class="node__why">
            <strong>Why it matters:</strong> {why}
          </p>
        )
      }

      {data.personas.length > 0 && <RoleToggle milestoneId={id} personas={data.personas} />}

      {
        receipts.length > 0 && (
          <section class="node__receipts">
            <h4 class="node__section-heading">
              Receipts
              <span class="node__section-note">every claim above, at its source</span>
            </h4>
            <ul class="node__receipt-list">
              {receipts.map((r) => (
                <li>
                  <a href={r.url} rel="noopener noreferrer" target="_blank">
                    {r.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {/* The note is assembled at build time and parked here as data. The
          button is added by script, so a reader with no JS never sees a
          control that cannot work. */}
      <script type="application/json" data-brief set:html={JSON.stringify(brief)} />
      <div class="node__tools" data-brief-tools hidden>
        <button type="button" class="node__tool" data-copy-brief>
          Copy briefing note
        </button>
        <p class="node__tool-note">
          Plain text: the facts, the selected take, and every source URL.
        </p>
      </div>
    </div>
  </details>
</article>

<style>
  .node {
    position: relative;
    padding-left: var(--sp-6);
    /* Grid items default to min-width:auto, so the nowrap badge row would set
       a min-content floor wider than a phone and push the whole page sideways.
       This lets the node shrink so flex-wrap can actually do its job. */
    min-width: 0;
  }

  /* ── The star on the spine ──────────────────────────────────────── */
  .node__marker {
    position: absolute;
    left: 0;
    top: 1.35rem;
    display: grid;
    place-items: center;
    width: 1.25rem;
  }

  .node__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tier-3);
    box-shadow: 0 0 0 4px var(--void);
    transition: box-shadow var(--dur) var(--ease);
  }

  [data-tier='2'] .node__dot {
    width: 11px;
    height: 11px;
    background: var(--tier-2);
    box-shadow: 0 0 0 4px var(--void), var(--ring-2);
  }

  [data-tier='1'] .node__dot {
    width: 16px;
    height: 16px;
    background: var(--tier-1);
    box-shadow: 0 0 0 5px var(--void), var(--ring-1);
  }

  [data-tier='1'] .node__marker::after {
    content: '';
    position: absolute;
    inset: -0.6rem;
    border: 1px solid rgb(245 208 32 / 0.3);
    border-radius: 50%;
  }

  /* ── Shell ──────────────────────────────────────────────────────── */
  .node__shell {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--void-raised);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .node__shell:hover {
    border-color: var(--hairline-strong);
  }

  [data-tier='2'] .node__shell {
    border-color: rgb(255 95 168 / 0.22);
  }

  [data-tier='1'] .node__shell {
    border-color: rgb(245 208 32 / 0.45);
    background: var(--void-panel);
  }

  .node__summary {
    position: relative;
    display: block;
    padding: var(--sp-4) var(--sp-5) var(--sp-4) var(--sp-4);
    cursor: pointer;
    list-style: none;
  }

  .node__summary::-webkit-details-marker {
    display: none;
  }

  /* ── Meta line ──────────────────────────────────────────────────── */
  .node__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    margin-bottom: var(--sp-2);
    font-size: var(--step--1);
  }

  .node__date {
    color: var(--riso-yellow);
    letter-spacing: 0.03em;
  }

  .node__symbol {
    color: var(--ink-faint);
  }

  .node__title {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--paper);
  }

  [data-tier='1'] .node__title {
    font-size: var(--step-2);
    font-weight: 700;
  }

  [data-tier='3'] .node__title {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink-dim);
  }

  .node__tldr-teaser {
    margin: var(--sp-2) 0 0;
    font-size: var(--step--1);
    color: var(--ink-dim);
    max-width: var(--measure-tight);
  }

  .node__shell[open] .node__tldr-teaser {
    display: none;
  }

  /* ── Tags ───────────────────────────────────────────────────────── */
  .node__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }

  /* Stardust hides its tags until opened — 40 compact rows stay scannable. */
  [data-tier='3'] .node__tags {
    display: none;
  }

  [data-tier='3'] .node__shell[open] .node__tags {
    display: flex;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.18em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    font-size: var(--step--2);
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .tag--tier[data-tier-tag='1'] {
    border-color: rgb(245 208 32 / 0.5);
    color: var(--riso-yellow);
  }

  .tag--tier[data-tier-tag='2'] {
    border-color: rgb(255 95 168 / 0.45);
    color: var(--riso-pink);
  }

  .tag--tier[data-tier-tag='3'] {
    border-color: rgb(47 191 116 / 0.5);
    color: var(--riso-green);
  }

  .tag--badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
  }

  .tag--badge[data-kind='fact'] {
    border-color: rgb(245 208 32 / 0.45);
    color: var(--riso-yellow);
  }

  .tag--badge[data-kind='process'] {
    border-color: rgb(255 95 168 / 0.35);
    color: var(--riso-pink);
  }

  .tag--badge[data-kind='caution'] {
    border-color: rgb(255 95 168 / 0.5);
    color: var(--signal);
  }

  .tag--takes {
    border-style: dashed;
    color: var(--ink-faint);
  }

  /* Duty station reads as a stamp, not a chip — it is a fact about where the
     file sits, and a delegate scanning for "Geneva" should find it fast. */
  .tag--venue {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-color: rgb(47 191 116 / 0.45);
    color: var(--riso-green);
  }

  .tag--organ {
    border-style: dotted;
    border-color: var(--hairline-strong);
  }

  /* ── Briefing note ──────────────────────────────────────────────── */
  .node__tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-5);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--paper-hairline);
  }

  .node__tools[hidden] {
    display: none;
  }

  .node__tool {
    padding: 0.4em 1em;
    border: 1px solid var(--pink-on-paper);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font: inherit;
    font-size: var(--step--1);
    color: var(--pink-on-paper);
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .node__tool:hover {
    background: var(--pink-on-paper);
    color: var(--paper);
  }

  .node__tool[data-state='copied'] {
    border-color: var(--riso-green-on-paper);
    background: var(--riso-green-on-paper);
    color: var(--paper);
  }

  .node__tool[data-state='failed'] {
    border-color: var(--riso-green-on-paper);
    color: var(--paper-ink);
  }

  .node__tool-note {
    margin: 0;
    font-size: var(--step--2);
    color: var(--paper-ink-faint);
  }

  /* ── Open/close affordance ──────────────────────────────────────── */
  .node__affordance {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    transition: transform var(--dur) var(--ease);
  }

  .node__affordance::before,
  .node__affordance::after {
    content: '';
    position: absolute;
    inset: 50% 25%;
    border-top: 1px solid var(--ink-dim);
    transform: translateY(-0.5px);
  }

  .node__affordance::after {
    transform: translateY(-0.5px) rotate(90deg);
  }

  .node__shell[open] .node__affordance {
    transform: rotate(45deg);
  }

  /* ── The paper ──────────────────────────────────────────────────── */
  /* Real page margins. The reading column is capped at --measure, so on a wide
     screen the extra width becomes margin rather than dead space — the panel
     reads as a document page, not a stretched band. */
  .node__paper {
    padding: var(--sp-6) clamp(var(--sp-5), 5.5vw, var(--sp-8));
    border-top: 3px solid var(--riso-yellow);
    box-shadow: inset 0 12px 24px -18px rgb(20 20 22 / 0.5);
    animation: paper-unfurl var(--dur-slow) var(--ease-out);
  }

  @keyframes paper-unfurl {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-tier='2'] .node__paper {
    border-top-color: var(--riso-pink);
  }

  [data-tier='3'] .node__paper {
    border-top-color: var(--riso-green);
    padding-block: var(--sp-5);
  }

  /* ── Mafi's take ────────────────────────────────────────────────── */
  .node__tldr {
    position: relative;
    margin-bottom: var(--sp-5);
    padding-left: var(--sp-4);
    border-left: 3px solid var(--pink-on-paper);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--paper-ink);
  }

  .node__tldr-mark {
    display: block;
    margin-bottom: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink-on-paper);
  }

  /* ── Pull quote (Supernovas) ────────────────────────────────────── */
  .node__quote {
    margin: 0 0 var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    background: var(--paper-sunk);
    border-radius: var(--radius-sm);
  }

  .node__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--paper-ink);
  }

  .node__quote blockquote::before {
    content: '“';
    color: var(--yellow-on-paper);
  }

  .node__quote blockquote::after {
    content: '”';
    color: var(--yellow-on-paper);
  }

  .node__quote figcaption {
    margin-top: var(--sp-2);
    font-size: var(--step--1);
    color: var(--paper-ink-faint);
  }

  /* ── Factual layer ──────────────────────────────────────────────── */
  .node__factual p {
    max-width: var(--measure);
    color: var(--paper-ink);
  }

  .node__factual :global(em) {
    font-style: italic;
    color: var(--paper-ink);
  }

  /* Glossary terms render as plain prose by default — a button stripped of
     every button affordance. The underline that says "ask A/BOT about this"
     only appears once A/BOT's script has confirmed it can answer. */
  .node__factual :global(.term) {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: text;
    transition: background var(--dur) var(--ease);
  }

  :global(html.abot-ready) .node__factual :global(.term) {
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--pink-on-paper);
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .node__factual :global(.term:hover),
  .node__factual :global(.term[aria-current='true']) {
    background: rgb(176 26 99 / 0.12);
    border-radius: 3px;
  }

  .node__why {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-left: 3px solid var(--riso-green-on-paper);
    background: rgb(47 191 116 / 0.1);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--paper-ink-dim);
    max-width: var(--measure);
  }

  .node__why strong {
    color: var(--riso-green-on-paper);
  }

  /* ── Section headings on paper ──────────────────────────────────── */
  .node__section-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    margin: var(--sp-5) 0 var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--paper-hairline);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-ink-faint);
  }

  .node__section-note {
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-body);
    font-style: italic;
  }

  /* ── Receipts ───────────────────────────────────────────────────── */
  .node__receipt-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .node__receipt-list a {
    display: inline-block;
    padding: 0.3em 0.8em;
    border: 1px solid var(--paper-hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    text-decoration: none;
    color: var(--pink-on-paper);
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .node__receipt-list a:hover {
    border-color: var(--pink-on-paper);
    background: var(--paper-sunk);
  }

  @media (pointer: coarse) {
    .node__tool {
      min-height: 44px;
    }
  }

  /* The tools are a screen affordance. On paper the note IS the page. */
  @media print {
    .node__tools {
      display: none !important;
    }
  }

  @media (max-width: 40rem) {
    .node {
      padding-left: var(--sp-5);
    }

    .node__summary {
      padding: var(--sp-3) var(--sp-6) var(--sp-3) var(--sp-3);
    }

    .node__paper {
      padding: var(--sp-5) var(--sp-4);
    }

    .node__affordance {
      top: var(--sp-3);
      right: var(--sp-3);
    }
  }
</style>

<script>
  /**
   * "Copy briefing note" — the request every one of these nodes eventually
   * generates, answered in one click.
   *
   * The static half of the note was built at build time (lib/brief.ts). The
   * only thing decided here is which take to include: whichever the reader has
   * open, read straight from the DOM so the copy always matches the screen.
   */
  type BriefParts = { head: string; body: string; tail: string };

  /** The take on screen — the selected tab, or the first if tabs never ran. */
  function selectedTake(node: HTMLElement): string {
    const panels = Array.from(node.querySelectorAll<HTMLElement>('[data-role-panel]'));
    const shown = panels.find((p) => !p.hidden) ?? panels[0];
    if (!shown) return '';

    const who = shown.querySelector('.take__who')?.textContent?.trim();
    const beats = Array.from(shown.querySelectorAll<HTMLElement>('.take__beat'))
      .map((beat) => {
        const label = beat.querySelector('dt')?.textContent?.trim();
        const value = beat.querySelector('dd')?.textContent?.trim();
        return label && value ? `${label}: ${value}` : null;
      })
      .filter((line): line is string => line !== null);

    if (!beats.length) return '';
    return [`FOR ${(who ?? 'this desk').toUpperCase()}`, ...beats].join('\n');
  }

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Clipboard API needs a secure context and a permission that some
      // managed desktops withhold. Fall back to a selection the reader can
      // copy by hand rather than failing silently.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand?.('copy') ?? false;
      area.remove();
      return ok;
    }
  }

  for (const tools of document.querySelectorAll<HTMLElement>('[data-brief-tools]')) {
    const node = tools.closest<HTMLElement>('[data-node]');
    const payload = node?.querySelector<HTMLScriptElement>('script[data-brief]');
    const button = tools.querySelector<HTMLButtonElement>('[data-copy-brief]');
    if (!node || !payload?.textContent || !button) continue;

    let parts: BriefParts;
    try {
      parts = JSON.parse(payload.textContent);
    } catch {
      continue; // a malformed payload should cost the reader nothing
    }

    tools.hidden = false;

    button.addEventListener('click', async () => {
      const take = selectedTake(node);
      const note = [parts.head, '', parts.body, ...(take ? ['', take] : []), '', parts.tail].join(
        '\n',
      );

      const ok = await copy(note);
      const label = button.textContent;
      button.dataset.state = ok ? 'copied' : 'failed';
      button.textContent = ok ? 'Copied' : 'Press Ctrl/Cmd+C';
      window.setTimeout(() => {
        delete button.dataset.state;
        button.textContent = label;
      }, 2200);
    });
  }
</script>
