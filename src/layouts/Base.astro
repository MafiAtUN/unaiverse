---
import '../styles/global.css';
import { SITE } from '../lib/taxonomy';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} — every UN milestone on AI, with receipts`,
  description = "One data nerd's lovingly sarcastic map of the UN's AI universe. 76 milestones from 2017 to 2027, every one sourced to the original document, explained for eight kinds of UN reader.",
} = Astro.props;

// Absolute URLs — social scrapers do not resolve relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.png`.replace(/\/+/g, '/'), Astro.site).href;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mafizul Islam" />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101011" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="UNAIVERSE — 76 milestones, 236 receipts, 156 reader takes, 2017 to 2027"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}/favicon.svg`.replace(/\/+/g, '/')} type="image/svg+xml" />

    {/* The fonts are self-hosted and the CSS is inlined by Astro, so there is
        nothing to preconnect to — deliberately no third-party origins. */}
  </head>
  <body>
    <a class="skip-link" href="#timeline">Skip to the timeline</a>
    <slot />
  </body>
</html>
