---
import '../styles/global.css';
import { SITE } from '../lib/taxonomy';

interface Props {
  title?: string;
  description?: string;
  /** `article` for a term page, so a share card reads as a document not a site. */
  ogType?: string;
  /** Extra <head> markup — used by term pages for JSON-LD. */
  head?: string;
  /** Where the skip link goes. The literacy pages have no #timeline. */
  skip?: { href: string; label: string };
}

const {
  title = `${SITE.name}: every UN milestone on AI, with receipts`,
  description = "One data nerd's lovingly sarcastic map of the UN's AI universe. 76 milestones from 2017 to 2027, every one sourced to the original document, explained for eight kinds of UN reader.",
  ogType = 'website',
  head,
  skip = { href: '#timeline', label: 'Skip to the timeline' },
} = Astro.props;

// Absolute URLs — social scrapers do not resolve relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.png`.replace(/\/+/g, '/'), Astro.site).href;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mafizul Islam" />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101011" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="UNAIVERSE: 76 milestones, 236 receipts, 156 reader takes, 2017 to 2027"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}/favicon.svg`.replace(/\/+/g, '/')} type="image/svg+xml" />

    {/* Discoverable by the thing that matters: an office piping the file into
        a Teams or Slack channel. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name}: every UN milestone on AI`}
      href={`${base}/rss.xml`.replace(/\/+/g, '/')}
    />

    {/* The fonts are self-hosted and the CSS is inlined by Astro, so there is
        nothing to preconnect to — deliberately no third-party origins. */}
    {head && <Fragment set:html={head} />}

    {/* Role memory, applied before first paint.

        A reader who chose "Peace & Security" last week must not watch the
        general framing render and then swap to theirs — that flash is the
        clutter this redesign removes, reintroduced one frame at a time. So
        this runs inline in <head>, ahead of the body, rather than in a module
        that waits for the parser. ~200 bytes, no request. */}
    <script is:inline>
      try {
        var r = localStorage.getItem('unaiverse:role');
        if (r) document.documentElement.dataset.role = r;
      } catch (e) {
        /* storage refused; the picker still works, it just re-asks */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href={skip.href}>{skip.label}</a>
    <slot />
  </body>
</html>
