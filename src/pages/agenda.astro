---
/**
 * THE AGENDA — the planning page.
 *
 * Two questions, in the order a delegation or a front office asks them:
 * what is coming, and who owes what. Both are derived from the corpus, so
 * neither can drift from the timeline.
 */
import Base from '../layouts/Base.astro';
import Starfield from '../components/Starfield.astro';
import {
  ledgerCounts,
  mandateLedger,
  openPeriods,
  recurringTracks,
  upcomingEvents,
  type MilestoneLike,
} from '../lib/agenda';
import { getCollection } from 'astro:content';
import { MANDATE_STATUS, ORGAN_BY_ID, SITE, VENUE_BY_ID } from '../lib/taxonomy';
import { FRESHNESS_LABEL, freshnessMap } from '../lib/freshness';

const entries = (await getCollection('milestones')) as unknown as MilestoneLike[];
const now = new Date();
const events = upcomingEvents(entries, now);
const periods = openPeriods(entries, now, new Set(events.map((e) => e.id)));
const recurring = recurringTracks(entries);
const ledger = mandateLedger(entries);
const counts = ledgerCounts(ledger);

// Journey J3: a delegate on their second visit, scanning for what moved.
// Flags come from the last stamped publish, not from this build.
const fresh = freshnessMap(entries as unknown as { id: string }[]);
const flagFor = (id: string) => {
  const f = fresh.get(id);
  return f && f !== 'unchanged' ? FRESHNESS_LABEL[f] : null;
};

const href = (path: string) => `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, '/');

const generated = now.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/** "in 3 weeks", "in 9 months" — the number a coverage decision turns on. */
function away(days: number): string {
  if (days === 0) return 'today';
  if (days === 1) return 'tomorrow';
  if (days < 21) return `in ${days} days`;
  if (days < 70) return `in ${Math.round(days / 7)} weeks`;
  return `in ${Math.round(days / 30)} months`;
}

const title = `The Agenda · ${SITE.name}`;
const description =
  'What the UN has still to do on AI, and who owes what by when. Every mandated meeting, report and review, with a calendar file you can subscribe to.';
---

<Base title={title} description={description}>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker mono">
        <a href={href('')}>{SITE.name}</a> / The Agenda
      </p>
      <h1 class="page-head__title">What is still to come, and who owes what</h1>
      <p class="page-head__lead">
        The timeline records what happened. This page is the other half: the meetings the
        Assembly has already scheduled, and the obligations its resolutions created. Both are
        assembled from the same sourced corpus, so nothing here is a guess about the future
        beyond what a document already says.
      </p>
      <p class="page-head__meta mono">
        Generated {generated} · {events.length} dated · {periods.length} pinned to a session ·
        {' '}{recurring.length} recurring · {ledger.length} obligations tracked
      </p>

      <nav class="page-head__jump" aria-label="On this page">
        <a href="#calendar">The calendar</a>
        <a href="#ledger">The ledger</a>
      </nav>
    </div>
  </header>

  <main id="timeline" class="wrap page">
    {/* ── The calendar ──────────────────────────────────────────────── */}
    <section class="section" id="calendar" aria-labelledby="calendar-title">
      <div class="section__head">
        <h2 class="section__title" id="calendar-title">The calendar</h2>
        <p class="section__blurb">
          Everything in the corpus that has not happened yet, soonest first. Dates the UN has
          not confirmed are marked as such rather than quietly invented.
        </p>
      </div>

      <div class="subscribe">
        <a class="subscribe__button" href={href('calendar.ics')} download>
          Add the whole file to your calendar
        </a>
        <p class="subscribe__note">
          One .ics with every scheduled item. Import it into Outlook, Google Calendar or
          anything else that reads a standard calendar file. Entries whose dates are not yet
          fixed import as tentative.
        </p>
      </div>

      {
        events.length === 0 ? (
          <p class="empty">
            Nothing in the corpus is scheduled ahead of today. That is unusual enough to be
            worth checking the content for a missing milestone.
          </p>
        ) : (
          <ol class="events">
            {events.map((ev) => (
              <li class="event" data-tier={ev.tier}>
                <div class="event__when">
                  <p class="event__date mono">{ev.dateDisplay}</p>
                  <p class="event__away mono">{away(ev.daysAway)}</p>
                  {ev.precision !== 'day' && (
                    <p class="event__tbc">exact dates not yet published</p>
                  )}
                </div>

                <div class="event__what">
                  <h3 class="event__title">
                    <a href={href(`m/${ev.id}`)}>{ev.title}</a>
                    {flagFor(ev.id) && (
                      <span class="flag mono" data-freshness={fresh.get(ev.id)}>
                        {flagFor(ev.id)}
                      </span>
                    )}
                  </h3>
                  <p class="event__gist">{ev.gist}</p>

                  <div class="event__tags">
                    {ev.symbol && <span class="pill pill--symbol mono">{ev.symbol}</span>}
                    {ev.venue.map((v) => (
                      <span class="pill pill--venue mono">{VENUE_BY_ID.get(v)?.label ?? v}</span>
                    ))}
                    {ev.organ.map((o) => (
                      <span class="pill">{ORGAN_BY_ID.get(o)?.label ?? o}</span>
                    ))}
                  </div>

                  <p class="event__actions">
                    <a class="event__ics" href={href(`calendar/${ev.id}.ics`)} download>
                      Add this one to your calendar
                    </a>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        )
      }

      {
        periods.length > 0 && (
          <div class="periods">
            <h3 class="periods__title">Coming, but not yet a date</h3>
            <p class="periods__blurb">
              These are pinned to a session or a cycle rather than a day. They are not in the
              calendar file, because a two-year all-day block helps nobody and inventing a date
              the Assembly has not set would be worse. Watch for the modalities.
            </p>
            <ul class="periods__list">
              {periods.map((p) => (
                <li class="period">
                  <p class="period__when mono">{p.dateDisplay}</p>
                  <h4 class="period__title">
                    <a href={href(`m/${p.id}`)}>{p.title}</a>
                    {flagFor(p.id) && (
                      <span class="flag mono" data-freshness={fresh.get(p.id)}>
                        {flagFor(p.id)}
                      </span>
                    )}
                  </h4>
                  <p class="event__gist">{p.gist}</p>
                  <div class="event__tags">
                    {p.symbol && <span class="pill pill--symbol mono">{p.symbol}</span>}
                    {p.venue.map((v) => (
                      <span class="pill pill--venue mono">{VENUE_BY_ID.get(v)?.label ?? v}</span>
                    ))}
                    {p.organ.map((o) => (
                      <span class="pill">{ORGAN_BY_ID.get(o)?.label ?? o}</span>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        recurring.length > 0 && (
          <div class="periods">
            <h3 class="periods__title">Recurring, with no date announced</h3>
            <p class="periods__blurb">
              These will meet again. Knowing that the summit is annual and in Geneva, or that the
              privacy item returns every Council cycle, is a coverage decision even without a
              date on it. They are not in the calendar file for the same reason as above: the
              date would have to be invented.
            </p>
            <ul class="periods__list">
              {recurring.map((r) => (
                <li class="period period--recurring">
                  <p class="period__when mono">Last recorded here: {r.lastSeen}</p>
                  <h4 class="period__title">
                    <a href={href(`m/${r.id}`)}>{r.title}</a>
                    {flagFor(r.id) && (
                      <span class="flag mono" data-freshness={fresh.get(r.id)}>
                        {flagFor(r.id)}
                      </span>
                    )}
                  </h4>
                  <p class="recur__cadence">{r.cadence}</p>
                  <p class="recur__next">{r.next}</p>
                  <div class="event__tags">
                    {r.venue.map((v) => (
                      <span class="pill pill--venue mono">{VENUE_BY_ID.get(v)?.label ?? v}</span>
                    ))}
                    {r.organ.map((o) => (
                      <span class="pill">{ORGAN_BY_ID.get(o)?.label ?? o}</span>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {/* ── The ledger ────────────────────────────────────────────────── */}
    <section class="section" id="ledger" aria-labelledby="ledger-title">
      <div class="section__head">
        <h2 class="section__title" id="ledger-title">Who owes what, by when</h2>
        <p class="section__blurb">
          Every obligation the milestones in this corpus created: the reports requested, the
          bodies to be appointed, the meetings to be convened, the reviews to be held. Status is
          a statement of fact about whether the thing has happened, and nothing more.
        </p>
      </div>

      <dl class="ledger-stats">
        {
          (['done', 'pending', 'upcoming'] as const).map((s) => (
            <div>
              <dt>
                <span aria-hidden="true">{MANDATE_STATUS[s].glyph}</span> {MANDATE_STATUS[s].label}
              </dt>
              <dd class="mono">{counts[s]}</dd>
            </div>
          ))
        }
      </dl>

      {/* Below 46rem the CSS flattens this into stacked cards, because the
          Status column otherwise sits 600px into a 340px container and the one
          thing a reader came for is off-screen. `display: block` on table
          elements strips their semantics in several browsers, so the roles are
          declared explicitly and survive the change. */}
      <div class="table-scroll">
        <table class="ledger" role="table">
          <caption class="visually-hidden">
            Obligations created by UN milestones on AI, in due order
          </caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">What</th>
              <th scope="col" role="columnheader">Who</th>
              <th scope="col" role="columnheader">By when</th>
              <th scope="col" role="columnheader">Status</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              ledger.map((row) => (
                <tr data-status={row.status} role="row">
                  <td role="cell">
                    <p class="ledger__what">{row.what}</p>
                    <p class="ledger__from">
                      From <a href={href(`m/${row.fromId}`)}>{row.fromTitle}</a>
                      {row.source && <span class="mono ledger__source">{row.source}</span>}
                    </p>
                    {row.note && <p class="ledger__note">{row.note}</p>}
                  </td>
                  <td class="ledger__who" role="cell" data-label="Who">
                    {row.who}
                  </td>
                  <td class="ledger__due" role="cell" data-label="By when">
                    {row.due}
                  </td>
                  <td role="cell" data-label="Status">
                    <span class="status" data-status={row.status}>
                      <span aria-hidden="true">{MANDATE_STATUS[row.status].glyph}</span>
                      {MANDATE_STATUS[row.status].label}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="section__foot">
        An obligation appears here only when a milestone file records it, with the document that
        created it. If something is missing, the honest reading is that this corpus has not
        captured it yet, not that no one owes it.
      </p>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p class="foot__lead">
        All facts are sourced to official UN documents. Status describes whether a mandated step
        has happened, and never how well anyone did it.
      </p>
      <p class="foot__fine">
        A personal project by Mafizul Islam. Not an official United Nations product, and nothing
        here represents the views of the UN or any of its offices.
      </p>
      <p>
        <a href={href('')}>Back to the timeline</a> · <a href={href('learn')}>Learn AI</a>
      </p>
    </div>
  </footer>

  <Starfield />
</Base>

<style>
  /* ── Page head ──────────────────────────────────────────────────── */
  .page-head {
    padding: var(--sp-8) 0 var(--sp-6);
    border-bottom: 1px solid var(--hairline);
  }

  .page-head__kicker {
    margin: 0 0 var(--sp-3);
    font-size: var(--step--2);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .page-head__kicker a {
    color: var(--riso-yellow);
    text-decoration: none;
  }

  .page-head__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--paper);
    max-width: 22ch;
  }

  .page-head__lead {
    margin-top: var(--sp-4);
    max-width: var(--measure);
    color: var(--ink-dim);
  }

  .page-head__meta {
    margin-top: var(--sp-4);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .page-head__jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .page-head__jump a {
    padding: 0.3em 0.9em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--ink-dim);
    text-decoration: none;
  }

  .page-head__jump a:hover {
    border-color: var(--riso-pink);
    color: var(--paper);
  }

  /* ── Sections ───────────────────────────────────────────────────── */
  .page {
    padding-bottom: var(--sp-8);
  }

  .section {
    padding-top: var(--sp-8);
    scroll-margin-top: var(--sp-4);
  }

  .section__head {
    max-width: var(--measure);
    margin-bottom: var(--sp-5);
  }

  .section__title {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  .section__blurb {
    margin-top: var(--sp-3);
    color: var(--ink-dim);
  }

  .section__foot {
    margin-top: var(--sp-5);
    max-width: var(--measure);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-faint);
  }

  .empty {
    color: var(--ink-faint);
    font-style: italic;
  }

  /* ── Subscribe ──────────────────────────────────────────────────── */
  .subscribe {
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
    padding: var(--sp-5);
    border: 1px solid rgb(245 208 32 / 0.4);
    border-radius: var(--radius);
    background: var(--void-raised);
  }

  .subscribe__button {
    justify-self: start;
    padding: 0.55em 1.3em;
    border-radius: var(--radius-sm);
    background: var(--riso-yellow);
    color: var(--void);
    font-weight: 600;
    text-decoration: none;
    transition: filter var(--dur) var(--ease);
  }

  .subscribe__button:hover {
    filter: brightness(1.1);
  }

  .subscribe__note {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  /* ── Events ─────────────────────────────────────────────────────── */
  .events {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--tier-3);
    border-radius: var(--radius);
    background: var(--void-raised);
  }

  .event[data-tier='1'] {
    border-left-color: var(--tier-1);
  }

  .event[data-tier='2'] {
    border-left-color: var(--tier-2);
  }

  .event__when {
    display: grid;
    align-content: start;
    gap: var(--sp-1);
  }

  .event__date {
    margin: 0;
    font-size: var(--step--1);
    color: var(--riso-yellow);
  }

  .event__away {
    margin: 0;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .event__tbc {
    margin: 0;
    font-size: var(--step--2);
    font-style: italic;
    color: var(--signal);
  }

  .event__title {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .event__title a {
    color: var(--paper);
    text-decoration: none;
  }

  .event__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event__gist {
    margin-top: var(--sp-2);
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .event__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }

  .event__actions {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
  }

  .event__ics {
    color: var(--riso-pink);
    text-underline-offset: 3px;
  }

  /* What moved since the last publish. Deliberately not a pill: pills on this
     page describe what a thing is, and this describes what happened to it. */
  .flag {
    display: inline-block;
    margin-left: var(--sp-2);
    padding: 0.1em 0.45em;
    border-radius: var(--radius-sm);
    background: var(--riso-pink);
    color: var(--void, #101011);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.15em;
  }

  .flag[data-freshness='updated'] {
    background: none;
    border: 1px solid var(--riso-pink);
    color: var(--riso-pink);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.18em 0.7em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: var(--step--2);
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .pill--symbol {
    border-color: rgb(245 208 32 / 0.45);
    color: var(--riso-yellow);
  }

  .pill--venue {
    border-color: rgb(47 191 116 / 0.45);
    color: var(--riso-green);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Periods ────────────────────────────────────────────────────── */
  .periods {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hairline);
  }

  .periods__title {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--paper);
  }

  .periods__blurb {
    margin-top: var(--sp-2);
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .periods__list {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .period {
    padding: var(--sp-4);
    border: 1px dashed var(--hairline-strong);
    border-radius: var(--radius);
  }

  .period__when {
    margin: 0 0 var(--sp-1);
    font-size: var(--step--2);
    color: var(--riso-yellow);
  }

  .period__title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .period__title a {
    color: var(--paper);
    text-decoration: none;
  }

  .period__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .period--recurring {
    border-left: 3px solid var(--riso-green);
  }

  .recur__cadence {
    margin-top: var(--sp-2);
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink);
  }

  .recur__next {
    margin-top: var(--sp-1);
    max-width: var(--measure);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-faint);
  }

  /* ── Ledger ─────────────────────────────────────────────────────── */
  .ledger-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-6);
    margin: 0 0 var(--sp-5);
    padding: var(--sp-4) 0;
    border-block: 1px solid var(--hairline);
  }

  .ledger-stats div {
    display: grid;
    gap: var(--sp-1);
  }

  .ledger-stats dt {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .ledger-stats dd {
    margin: 0;
    font-size: var(--step-1);
    color: var(--paper);
  }

  /* A wide table on a narrow screen scrolls inside its own box; the page
     itself must never scroll sideways. */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .ledger {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .ledger th {
    position: sticky;
    top: 0;
    padding: var(--sp-3) var(--sp-4);
    background: var(--void-panel);
    border-bottom: 1px solid var(--hairline-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-faint);
  }

  .ledger td {
    padding: var(--sp-4);
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    color: var(--ink-dim);
  }

  .ledger tbody tr:last-child td {
    border-bottom: 0;
  }

  .ledger tbody tr[data-status='upcoming'] {
    background: rgb(245 208 32 / 0.05);
  }

  .ledger__what {
    margin: 0;
    color: var(--paper);
    max-width: 42ch;
  }

  .ledger__from {
    margin: var(--sp-2) 0 0;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .ledger__from a {
    color: var(--ink-dim);
  }

  .ledger__source {
    margin-left: var(--sp-2);
    color: var(--riso-yellow);
  }

  .ledger__note {
    margin: var(--sp-2) 0 0;
    max-width: 42ch;
    font-size: var(--step--2);
    font-style: italic;
    color: var(--ink-faint);
  }

  .ledger__who,
  .ledger__due {
    min-width: 9rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.7em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: var(--step--2);
    white-space: nowrap;
  }

  .status[data-status='done'] {
    border-color: rgb(47 191 116 / 0.5);
    color: var(--riso-green);
  }

  .status[data-status='pending'] {
    border-color: rgb(255 95 168 / 0.45);
