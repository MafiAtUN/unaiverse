---
/**
 * /m/<id> — one milestone, one URL.
 *
 * The brief asks for "a stable deep link she can paste to her team", and the
 * old site could not give her one: every milestone lived at `/#<id>`, a hash
 * into an 843 KB homepage that opened a <details> after the fact. Forwarding
 * that link sent a colleague to a page that took seconds to become readable
 * and then jumped.
 *
 * This is a page. It is roughly 20 KB, it has a title and a description of its
 * own, it renders identically with JavaScript switched off, and it is what the
 * search results, the agenda, the calendar entries and the RSS feed all point
 * at now.
 *
 * ── The take, and only the take that is yours ────────────────────────────
 * The brief's firmest rule: never show all eight at once. Every take is in the
 * markup — they are static content and hiding them client-side would mean a
 * flash of all eight — and CSS shows exactly the one matching the role on
 * <html>, which Base.astro sets before first paint. The "other roles"
 * expander holds its own copy of each take with the reader's own hidden, so
 * the whole mechanism is static CSS and costs no JavaScript at all.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import RolePicker from '../../components/RolePicker.astro';
import TakeBody from '../../components/TakeBody.astro';
import JargonPopover from '../../components/JargonPopover.astro';
import { parseMilestoneBody, sortKey } from '../../lib/milestone';
import { markupFactual } from '../../lib/glossary';
import { jargonPayload } from '../../lib/jargon';
import { buildBrief, flattenBrief } from '../../lib/brief';
import { getTake } from '../../lib/takes';
import {
  BADGE_KIND,
  CONSTELLATIONS,
  GENERAL_ROLE,
  ORGAN_BY_ID,
  PERSONAS,
  SITE,
  TIERS,
  VENUE_BY_ID,
} from '../../lib/taxonomy';

export async function getStaticPaths() {
  const all = await getCollection('milestones');
  const chronological = [...all].sort(
    (a, b) =>
      sortKey(a.data.date_display, a.data.year, a.id) -
        sortKey(b.data.date_display, b.data.year, b.id) ||
      a.data.tier - b.data.tier ||
      a.data.title.localeCompare(b.data.title),
  );

  return chronological.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      // Neighbours in time. Someone reading the file in order should not have
      // to go back to the list to keep going.
      prev: chronological[i - 1] ?? null,
      next: chronological[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data, id } = entry;

const { factual, receipts, why } = parseMilestoneBody(entry.body ?? '');
const tier = TIERS[data.tier];
const constellation = CONSTELLATIONS[data.constellation];
const venues = data.venue.map((v) => VENUE_BY_ID.get(v)).filter((v) => v !== undefined);
const organs = data.organ.map((o) => ORGAN_BY_ID.get(o)).filter((o) => o !== undefined);

const href = (path: string) => `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, '/');
const milestoneHref = (mid: string) => href(`m/${mid}`);
const canonical = new URL(milestoneHref(id), Astro.site).href;

const brief = buildBrief({
  id,
  title: data.title,
  dateDisplay: data.date_display,
  symbol: data.symbol,
  badges: data.badges,
  venue: data.venue,
  organ: data.organ,
  body: entry.body ?? '',
  url: canonical,
});
const briefingNote = flattenBrief(brief);

/**
 * Every take this milestone declares, plus a placeholder for every persona it
 * does not. Without the placeholders, a reader whose role has no take here
 * would select their role and watch the whole section vanish — which reads as
 * a broken page rather than as an honest gap.
 */
const written = new Set(data.personas);
const takes = PERSONAS.filter((p) => written.has(p.id)).map((p) => ({
  persona: p,
  take: getTake(id, p.id),
}));
const missing = PERSONAS.filter((p) => !written.has(p.id));

// Jargon is underlined at build time and explained in place — the popover
// carries definitions for exactly the terms this milestone used.
const { html: factualHtml, terms: jargonSlugs } = markupFactual(factual);
const jargon = jargonPayload(jargonSlugs);

const title = `${data.title} · ${SITE.name}`;
const description = why || factual.slice(0, 155);
---

<Base
  title={title}
  description={description}
  ogType="article"
  skip={{ href: '#record', label: 'Skip to the record' }}
>
  <div class="wrap page">
    <nav class="crumb mono" aria-label="Breadcrumb">
      <a href={href('')}>{SITE.name}</a>
      <span aria-hidden="true">/</span>
      <a href={href('timeline')}>Timeline</a>
    </nav>

    <header class="head">
      <div class="head__meta">
        <time class="mono head__date">{data.date_display}</time>
        {
          data.symbol && (
            <span class="head__symbol">
              <span class="mono">{data.symbol}</span>
              <CopyButton
                text={data.symbol}
                label="Copy"
                context={`document symbol ${data.symbol}`}
              />
            </span>
          )
        }
      </div>

      <h1 class="head__title">{data.title}</h1>

      {why && <p class="head__why"><strong>Why it matters:</strong> {why}</p>}

      <div class="head__actions">
        <CopyButton
          variant="button"
          text={canonical}
          label="Copy link"
          context="to this milestone"
        />
        <CopyButton
          variant="button"
          text={briefingNote}
          label="Copy briefing note"
          context="for this milestone, as plain text"
        />
      </div>
    </header>

    <main id="record" class="record on-paper on-paper--ruled">
      {
        data.tldr && (
          <p class="record__tldr">
            <span class="record__tldr-mark">Mafi's take</span>
            {data.tldr}
          </p>
        )
      }

      {
        data.quote && (
          <figure class="record__quote">
            <blockquote>{data.quote.text}</blockquote>
            <figcaption>
              {data.quote.url ? (
                <a href={data.quote.url} rel="noopener noreferrer" target="_blank">
                  {data.quote.attribution}
                </a>
              ) : (
                data.quote.attribution
              )}
            </figcaption>
          </figure>
        )
      }

      <div class="record__prose">
        <p set:html={factualHtml} />
      </div>

      {/* ── What this means for you ─────────────────────────────────── */}
      <section class="takes" aria-labelledby="takes-heading">
        <div class="takes__head">
          <h2 class="takes__heading" id="takes-heading">What this means for</h2>
          <div class="takes__picker">
            <RolePicker variant="compact" hideLabel />
          </div>
        </div>

        {/* The general reading, and the default. Someone who has never chosen
            a role — journey J2's intern — gets this and is never asked to. */}
        <div class="take take--general" data-role-view={GENERAL_ROLE.id}>
          <p class="take__who mono">
            <span aria-hidden="true">{GENERAL_ROLE.glyph}</span>
            {GENERAL_ROLE.label}
          </p>
          <p class="take__line">
            {data.tldr ?? why ?? 'The record above is the whole story on this one.'}
          </p>
          <p class="take__hint">
            Pick a role above and this becomes the reading for that desk: what it means, what
            to watch, and a line you can use.
          </p>
        </div>

        {
          takes.map(({ persona, take }) => (
            <div class="take" data-role-view={persona.id}>
              <TakeBody persona={persona} take={take} copyable />
            </div>
          ))
        }

        {
          missing.map((persona) => (
            <div class="take take--absent" data-role-view={persona.id}>
              <p class="take__who mono">
                <span aria-hidden="true">{persona.glyph}</span>
                {persona.label}
              </p>
              <p class="take__line">
                No {persona.label} reading was written for this one: it was judged to sit
                outside that desk. {why}
              </p>
            </div>
          ))
        }

        {/* The quiet expander the brief asks for. The takes inside it are a
            second rendering rather than the same nodes revealed from a
            distance: a <details> whose content lives outside itself announces
            as expanded and then has nothing to read. Whichever take is
            currently the reader's own is hidden in here, because "other" is
            the whole point of the control. */}
        {
          takes.length > 1 && (
            <details class="takes__others">
              <summary>How other roles read this</summary>
              <div class="takes__others-body">
                {takes.map(({ persona, take }) => (
                  <div class="take take--other" data-other-view={persona.id}>
                    <TakeBody persona={persona} take={take} />
                  </div>
                ))}
              </div>
            </details>
          )
        }
      </section>

      {/* ── Receipts ─────────────────────────────────────────────────── */}
      {
        receipts.length > 0 && (
          <section class="receipts" aria-labelledby="receipts-heading">
            <h2 class="receipts__heading" id="receipts-heading">
              Sources
            </h2>
            <ul class="receipts__list">
              {receipts.map((r) => (
                <li class="receipts__item">
                  <a href={r.url} rel="noopener noreferrer" target="_blank">
                    {r.label}
                  </a>
                  <CopyButton
                    text={`${r.label}: ${r.url}`}
                    label="Cite"
                    context={r.label}
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {/* ── The metadata the card no longer carries ──────────────────── */}
      <section class="meta" aria-labelledby="meta-heading">
        <h2 class="meta__heading" id="meta-heading">Details</h2>
        <dl class="meta__list">
          <div>
            <dt>Significance</dt>
            <dd>
              <span aria-hidden="true">{tier.glyph}</span>
              {tier.name}
            </dd>
          </div>
          {
            constellation && (
              <div>
                <dt>Track</dt>
                <dd>
                  <span aria-hidden="true">{constellation.glyph}</span>
                  {constellation.label}
                </dd>
              </div>
            )
          }
          {
            data.badges.length > 0 && (
              <div>
                <dt>Character</dt>
                <dd>
                  {data.badges.map((b) => (
                    <span class="meta__badge" data-kind={BADGE_KIND[b] ?? 'process'}>
                      {b}
                    </span>
                  ))}
                </dd>
              </div>
            )
          }
          {
            venues.length > 0 && (
              <div>
                <dt>Duty station</dt>
                <dd>{venues.map((v) => v.label).join(' · ')}</dd>
              </div>
            )
          }
          {
            organs.length > 0 && (
              <div>
                <dt>Body</dt>
                <dd>{organs.map((o) => o.label).join(' · ')}</dd>
              </div>
            )
          }
          {
            takes.length > 0 && (
              <div>
                <dt>Takes written</dt>
                <dd>{takes.length} of {PERSONAS.length}</dd>
              </div>
            )
          }
        </dl>
      </section>
    </main>

    <nav class="pager" aria-label="Nearby milestones">
      {
        prev && (
          <a class="pager__link pager__link--prev" href={milestoneHref(prev.id)}>
            <span class="pager__dir mono">← Before</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="pager__link pager__link--next" href={milestoneHref(next.id)}>
            <span class="pager__dir mono">After →</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        )
      }
    </nav>

    <JargonPopover entries={jargon} />
  </div>
</Base>

<style>
  .page {
    padding: var(--sp-6) 0 var(--sp-8);
  }

  .crumb {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .crumb a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .crumb a:hover,
  .crumb a:focus-visible {
    color: var(--paper);
  }

  /* ── Head ───────────────────────────────────────────────────────── */
  .head {
    margin: var(--sp-5) 0 var(--sp-6);
    max-width: var(--measure);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--step--1);
  }

  .head__date {
    color: var(--riso-yellow);
    letter-spacing: 0.04em;
  }

  .head__symbol {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ink-dim);
  }

  .head__title {
    margin: var(--sp-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--paper);
  }

  .head__why {
    margin: var(--sp-4) 0 0;
    font-size: var(--step-0);
    color: var(--ink-dim);
  }

  .head__why strong {
    color: var(--paper);
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  /* ── The record, on paper ───────────────────────────────────────── */
  .record {
    padding: var(--sp-6) var(--sp-5);
    border-radius: var(--radius);
  }

  .record__tldr {
    margin: 0 0 var(--sp-5);
    font-size: var(--step-0);
  }

  .record__tldr-mark {
    display: block;
    margin-bottom: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink-on-paper);
  }

  .record__quote {
    margin: 0 0 var(--sp-5);
    padding-left: var(--sp-4);
    border-left: 3px solid var(--pink-on-paper);
  }

  .record__quote blockquote {
    margin: 0;
    font-size: var(--step-1);
    font-style: italic;
  }

  .record__quote figcaption {
    margin-top: var(--sp-2);
    font-size: var(--step--1);
    color: var(--paper-ink-faint);
  }

  .record__prose {
    max-width: var(--measure);
    line-height: var(--leading-body, 1.65);
  }

  /* ── Takes ──────────────────────────────────────────────────────── */
  .takes {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--paper-hairline);
  }

  .takes__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .takes__heading {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-ink-faint);
  }

  .takes__picker {
    flex: 1 1 22rem;
  }

  /*  The whole role mechanism, in four rules.
   *
   *  Everything is hidden; the role on <html> reveals exactly one. The default
   *  — no attribute at all, because the reader has never chosen — reveals the
   *  general reading. Base.astro sets the attribute inline in <head>, so the
   *  right take is the first one painted, not a swap after hydration. */
  [data-role-view] {
    display: none;
  }

  :global(html:not([data-role])) .take--general,
  :global(html[data-role='curious']) .take--general {
    display: block;
  }

  :global(html[data-role='peace-security']) [data-role-view='peace-security'],
  :global(html[data-role='development']) [data-role-view='development'],
  :global(html[data-role='human-rights']) [data-role-view='human-rights'],
  :global(html[data-role='data-digital']) [data-role-view='data-digital'],
  :global(html[data-role='front-office']) [data-role-view='front-office'],
  :global(html[data-role='opga']) [data-role-view='opga'],
  :global(html[data-role='builders']) [data-role-view='builders'],
  :global(html[data-role='missions']) [data-role-view='missions'] {
    display: block;
  }

  /*  Inside the expander every take is visible except the reader's own, which
   *  is already on screen above it. */
  :global(html[data-role='peace-security']) [data-other-view='peace-security'],
  :global(html[data-role='development']) [data-other-view='development'],
  :global(html[data-role='human-rights']) [data-other-view='human-rights'],
  :global(html[data-role='data-digital']) [data-other-view='data-digital'],
  :global(html[data-role='front-office']) [data-other-view='front-office'],
  :global(html[data-role='opga']) [data-other-view='opga'],
  :global(html[data-role='builders']) [data-other-view='builders'],
  :global(html[data-role='missions']) [data-other-view='missions'] {
    display: none;
  }

  .take + .take,
  .take + .takes__others {
    margin-top: var(--sp-4);
  }

  .takes__others-body {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--paper-hairline);
  }

  /* Used by the general and "no take here" blocks, which are written inline
     on this page rather than through TakeBody. */
  .take__who {
    margin: 0 0 var(--sp-2);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pink-on-paper);
  }

  .take__line {
    margin: 0;
    max-width: var(--measure);
  }

  .take__hint {
    margin: var(--sp-2) 0 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--paper-ink-faint);
  }

  .takes__others {
    margin-top: var(--sp-4);
  }

  .takes__others summary {
    display: inline-block;
    font-size: var(--step--1);
    color: var(--paper-ink-faint);
    cursor: pointer;
  }

  .takes__others summary:hover {
    color: var(--paper-ink);
  }

  /* ── Receipts ───────────────────────────────────────────────────── */
  .receipts,
  .meta {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--paper-hairline);
  }

  .receipts__heading,
  .meta__heading {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-ink-faint);
  }

  .receipts__list {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .receipts__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }

  .receipts__item a {
    color: var(--paper-ink);
  }

  /* ── Metadata ───────────────────────────────────────────────────── */
  .meta__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--sp-4);
    margin: 0;
  }

  .meta__list dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-ink-faint);
  }

  .meta__list dd {
    margin: var(--sp-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
  }

  .meta__badge {
    padding: 0.1em 0.5em;
    border: 1px solid var(--paper-hairline);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .meta__badge[data-kind='fact'] {
    border-color: var(--pink-on-paper);
    color: var(--pink-on-paper);
  }

  /* ── Pager ──────────────────────────────────────────────────────── */
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .pager__link {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .pager__link:hover,
  .pager__link:focus-visible {
    border-color: var(--riso-pink);
  }

  .pager__link--next {
    text-align: right;
  }

  .pager__dir {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--riso-yellow);
  }

  .pager__title {
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  @media (max-width: 40rem) {
    .record {
      padding: var(--sp-5) var(--sp-4);
    }

    .pager__link--next {
      text-align: left;
    }
  }
</style>
