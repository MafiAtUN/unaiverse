---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MilestoneNode from '../components/MilestoneNode.astro';
import FilterBar from '../components/FilterBar.astro';
import ABot from '../components/ABot.astro';
import Starfield from '../components/Starfield.astro';
import { sortKey } from '../lib/milestone';
import { takeLoadReport, unboundTakes } from '../lib/takes';
import { SITE, ZONES, ZONE_ORDER, TIERS } from '../lib/taxonomy';

const all = await getCollection('milestones');

const sorted = all
  .map((entry) => ({
    entry,
    key: sortKey(entry.data.date_display, entry.data.year, entry.id),
  }))
  // Chronological; on a tie the weightier node leads, so "Pact for the Future
  // adopted" sits above "Global Digital Compact beyond AI" on 22 Sep 2024.
  .sort(
    (a, b) =>
      a.key - b.key ||
      a.entry.data.tier - b.entry.data.tier ||
      a.entry.data.title.localeCompare(b.entry.data.title),
  )
  .map((x) => x.entry);

const byZone = ZONE_ORDER.map((z) => ({
  zone: ZONES[z],
  items: sorted.filter((m) => m.data.zone === z),
}));

const tierCounts: Record<number, number> = { 1: 0, 2: 0, 3: 0 };
const constellationCounts: Record<string, number> = {};
for (const m of sorted) {
  tierCounts[m.data.tier]!++;
  constellationCounts[m.data.constellation] =
    (constellationCounts[m.data.constellation] ?? 0) + 1;
}

const takeSlots = sorted.reduce((n, m) => n + m.data.personas.length, 0);
const takes = takeLoadReport();
const receiptCount = sorted.reduce(
  (n, m) => n + (m.body?.match(/https?:\/\/[^\s)>"]+/g)?.length ?? 0),
  0,
);

// Build-time invariants, established in Phase 1.
if (sorted.length !== 76) {
  console.warn(`[unaiverse] expected 76 milestones, found ${sorted.length}`);
}
if (takeSlots !== 156) {
  console.warn(`[unaiverse] expected 156 take slots, found ${takeSlots}`);
}
console.log(
  `[unaiverse] ${sorted.length} milestones · ${takeSlots} take slots · ` +
    `${takes.loaded}/${takes.expected} takes loaded` +
    (takes.skipped.length ? ` · ${takes.skipped.length} skipped` : ''),
);
for (const s of takes.skipped.slice(0, 5)) {
  console.warn(`[unaiverse] take skipped (${s.reason}):`, s.sample);
}
const slotKeys = new Set(sorted.flatMap((m) => m.data.personas.map((p) => `${m.id}::${p}`)));
for (const o of unboundTakes(slotKeys)) {
  console.warn(
    `[unaiverse] take binds to no slot: "${o.milestoneId}" / "${o.persona}" — check spelling`,
  );
}
---

<Base>
  <header class="hero">
    <div class="hero__field" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="hero__kicker mono">A totally unofficial field guide</p>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__tagline">{SITE.tagline}</p>

      <p class="hero__blurb">
        For roughly 77 years the United Nations was busy with minor side quests — peace,
        human rights, development — and mentioned artificial intelligence approximately
        never. Then a chatbot launched in November 2022. Here is everything that happened
        next, with receipts.
      </p>

      <dl class="hero__stats">
        <div>
          <dt>Milestones</dt>
          <dd>{sorted.length}</dd>
        </div>
        <div>
          <dt>{TIERS[1].glyph} Supernova</dt>
          <dd>{tierCounts[1]}</dd>
        </div>
        <div>
          <dt>{TIERS[2].glyph} Star</dt>
          <dd>{tierCounts[2]}</dd>
        </div>
        <div>
          <dt>{TIERS[3].glyph} Stardust</dt>
          <dd>{tierCounts[3]}</dd>
        </div>
        <div>
          <dt>Receipts</dt>
          <dd>{receiptCount}</dd>
        </div>
        <div>
          <dt>Takes</dt>
          <dd>{takes.loaded}<span class="hero__of">/{takeSlots}</span></dd>
        </div>
      </dl>

      <nav class="hero__zones" aria-label="Jump to a zone">
        {
          byZone.map(({ zone, items }) => (
            <a href={`#zone-${zone.id}`} class="hero__zone-link">
              <span class="hero__zone-num mono">{zone.id}</span>
              <span class="hero__zone-name">{zone.title}</span>
              <span class="hero__zone-count mono">{items.length}</span>
            </a>
          ))
        }
      </nav>

      <p class="hero__alt">
        Prefer a straight line to a galaxy?{' '}
        <a href={`${import.meta.env.BASE_URL}/story`.replace(/\/+/g, '/')}>
          Scrub the whole decade on one axis →
        </a>
      </p>

      <p class="hero__phase">
        Every milestone opens onto a paper reading panel with its sources and a take for each
        kind of reader. Scroll to 30 November 2022 for the Big Bang.{' '}
        {
          takes.loaded === 0
            ? 'The 156 takes are still being written; their slots are live and fill the moment the file lands.'
            : takes.loaded < takes.expected
              ? `${takes.loaded} of ${takes.expected} takes have landed so far.`
              : ''
        }
      </p>
    </div>
  </header>

  <FilterBar
    constellationCounts={constellationCounts}
    tierCounts={tierCounts}
    total={sorted.length}
  />

  <main id="timeline" class="wrap">
    {
      byZone.map(({ zone, items }) => (
        <section
          class:list={['zone', { 'zone--bang': zone.id === 1 }]}
          aria-labelledby={`zone-${zone.id}`}
          data-zone
          data-bigbang={zone.id === 1 ? '' : undefined}
        >
          <div
            class="zone__head"
            id={`zone-${zone.id}`}
            data-bigbang-flash={zone.id === 1 ? '' : undefined}
          >
            <p class="zone__num mono">Zone {zone.id}</p>
            <h2 class="zone__title">{zone.title}</h2>
            <p class="zone__range mono">{zone.range}</p>
            <p class="zone__blurb">{zone.blurb}</p>
          </div>

          <div class="zone__nodes">
            {items.map((m) => (
              <MilestoneNode id={m.id} data={m.data} body={m.body ?? ''} />
            ))}
          </div>
        </section>
      ))
    }
  </main>

  <footer class="foot">
    <div class="wrap">
      <p class="foot__lead">
        All facts are sourced to official UN documents. All jokes are the author's own and
        aimed strictly at hype and bureaucratic pacing — never at the Organization, its
        officials, or any Member State.
      </p>
      <p class="foot__fine">
        A personal project by Mafizul Islam, built with Claude Code. Not an official United
        Nations product, and nothing here represents the views of the UN or any of its
        offices. It does, however, link to a lot of things that do.
      </p>
    </div>
  </footer>

  <Starfield />
  <ABot />
</Base>

<style>
  /* ── Hero ───────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--sp-8) 0 var(--sp-7);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }

  /* A hint of the star-field Phase 4 will build properly. Two radial
     gradients, no canvas, no JS — it costs nothing. */
  .hero__field {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% -10%, rgb(255 95 168 / 0.09), transparent 70%),
      radial-gradient(ellipse 45% 40% at 85% 15%, rgb(47 191 116 / 0.06), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  .hero__kicker {
    margin: 0 0 var(--sp-3);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--riso-yellow);
    font-size: var(--step--2);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    /* Solid. Gradient-filled display text is the most recognisable AI-landing-
       page move of the last three years; the headline earns attention from
       scale and a rule, not from a colour ramp. */
    color: var(--paper);
  }

  .hero__title::after {
    content: '';
    display: block;
    width: 5.5rem;
    height: 4px;
    margin-top: var(--sp-4);
    background: var(--riso-pink);
  }

  .hero__tagline {
    margin-top: var(--sp-3);
    font-size: var(--step-1);
    color: var(--ink-dim);
    max-width: var(--measure);
  }

  .hero__blurb {
    margin-top: var(--sp-4);
    color: var(--ink-dim);
    max-width: var(--measure);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-6);
    margin: var(--sp-6) 0 var(--sp-5);
    padding: var(--sp-4) 0;
    border-block: 1px solid var(--hairline);
  }

  .hero__stats div {
    display: grid;
    gap: var(--sp-1);
  }

  .hero__stats dt {
    font-size: var(--step--2);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .hero__stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--paper);
  }

  .hero__of {
    color: var(--ink-faint);
    font-size: 0.65em;
  }

  .hero__zones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
  }

  .hero__zone-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4) var(--sp-2) var(--sp-3);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-dim);
    font-size: var(--step--1);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .hero__zone-link:hover {
    border-color: var(--riso-pink);
    color: var(--paper);
  }

  .hero__zone-num {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgb(255 95 168 / 0.16);
    color: var(--riso-pink);
    font-size: var(--step--2);
  }

  .hero__zone-count {
    color: var(--ink-faint);
    font-size: var(--step--2);
  }

  /* The second view. Offered, not pushed — the galaxy is the front door. */
  .hero__alt {
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .hero__alt a {
    color: var(--riso-pink);
    text-decoration-color: rgb(255 95 168 / 0.4);
    text-underline-offset: 3px;
  }

  .hero__alt a:hover,
  .hero__alt a:focus-visible {
    color: var(--paper);
    text-decoration-color: currentColor;
  }

  .hero__phase {
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .hero__phase strong {
    color: var(--signal);
  }

  /* ── Zones ──────────────────────────────────────────────────────── */
  .zone {
    padding: var(--sp-8) 0 var(--sp-6);
    border-bottom: 1px solid var(--hairline);
  }

  .zone[hidden] {
    display: none;
  }

  .zone:last-of-type {
    border-bottom: 0;
  }

  .zone__head {
    max-width: var(--measure);
    margin-bottom: var(--sp-6);
    /* No scroll-margin here — FilterBar sets scroll-padding-top on <html>
       to its own measured height, so the two would double-count. */
  }

  .zone__num {
    margin: 0 0 var(--sp-2);
    font-size: var(--step--2);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--riso-pink);
  }

  .zone__title {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .zone__range {
    margin: var(--sp-2) 0 var(--sp-3);
    color: var(--riso-yellow);
    font-size: var(--step--1);
  }

  .zone__blurb {
    color: var(--ink-dim);
    font-style: italic;
  }

  /* ── Zone 1: the Big Bang ───────────────────────────────────────────
     The one moment that gets the animation budget (plan §7). Extra room
     above and below so the detonation has sky to happen in, and the single
     node inside it sits centre stage. */
  .zone--bang {
    padding-block: clamp(var(--sp-8), 22vh, 14rem);
    text-align: center;
    border-bottom-color: rgb(245 208 32 / 0.28);
  }

  .zone--bang .zone__head {
    max-width: 42rem;
    margin-inline: auto;
  }

  .zone--bang .zone__num {
    color: var(--riso-yellow);
  }

  .zone--bang .zone__title {
    font-size: var(--step-4);
    color: var(--riso-yellow);
  }

  .zone--bang .zone__blurb {
    margin-inline: auto;
    font-size: var(--step-1);
    font-style: normal;
    color: var(--ink);
  }

  .zone--bang .zone__nodes {
    text-align: left;
    max-width: 54rem;
    margin-inline: auto;
  }

  /* No spine through the Big Bang — the timeline breaks here, on purpose. */
  .zone--bang .zone__nodes::before {
    display: none;
  }

  .zone--bang .zone__nodes :global(.node) {
    padding-left: 0;
  }

  .zone--bang .zone__nodes :global(.node__marker) {
    display: none;
  }

  /* The spine. Phase 4 replaces this with the galaxy; this stays as the
     reduced-motion and mobile fallback. */
  .zone__nodes {
    position: relative;
    display: grid;
    gap: var(--sp-3);
  }

  .zone__nodes::before {
    content: '';
    position: absolute;
    left: 0.625rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--hairline-strong) 6%,
      var(--hairline-strong) 94%,
      transparent
    );
  }

  /* ── Footer ─────────────────────────────────────────────────────── */
  .foot {
    padding: var(--sp-7) 0 var(--sp-8);
    border-top: 1px solid var(--hairline);
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .foot__lead {
    color: var(--ink-dim);
  }

  .foot__fine {
    font-style: italic;
  }

  @media (max-width: 40rem) {
    .zone__nodes::before {
      left: 0.5rem;
    }

    .hero {
      padding-top: var(--sp-7);
    }
  }
</style>
