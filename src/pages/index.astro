---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MilestoneNode from '../components/MilestoneNode.astro';
import ABot from '../components/ABot.astro';
import { sortKey } from '../lib/milestone';
import { takeLoadReport, unboundTakes } from '../lib/takes';
import { SITE, ZONES, ZONE_ORDER, TIERS, type ZoneId } from '../lib/taxonomy';

const all = await getCollection('milestones');

const sorted = all
  .map((entry) => ({
    entry,
    key: sortKey(entry.data.date_display, entry.data.year, entry.id),
  }))
  // Chronological; on a tie the weightier node leads, so "Pact for the Future
  // adopted" sits above "Global Digital Compact beyond AI" on 22 Sep 2024.
  .sort(
    (a, b) =>
      a.key - b.key ||
      a.entry.data.tier - b.entry.data.tier ||
      a.entry.data.title.localeCompare(b.entry.data.title),
  )
  .map((x) => x.entry);

const byZone = ZONE_ORDER.map((z) => ({
  zone: ZONES[z],
  items: sorted.filter((m) => m.data.zone === z),
}));

const tierCounts = { 1: 0, 2: 0, 3: 0 } as Record<1 | 2 | 3, number>;
for (const m of sorted) tierCounts[m.data.tier]++;

const takeSlots = sorted.reduce((n, m) => n + m.data.personas.length, 0);
const takes = takeLoadReport();

// Build-time sanity: these are the invariants Phase 1 established.
if (sorted.length !== 76) {
  console.warn(`[unaiverse] expected 76 milestones, found ${sorted.length}`);
}
if (takeSlots !== 156) {
  console.warn(`[unaiverse] expected 156 take slots, found ${takeSlots}`);
}
console.log(
  `[unaiverse] ${sorted.length} milestones · ${takeSlots} take slots · ` +
    `${takes.loaded}/${takes.expected} takes loaded` +
    (takes.skipped.length ? ` · ${takes.skipped.length} skipped` : ''),
);
for (const s of takes.skipped.slice(0, 5)) {
  console.warn(`[unaiverse] take skipped (${s.reason}):`, s.sample);
}

// A take whose milestone_id or persona matches no slot loads fine and then
// renders nowhere. Catch those here rather than shipping a silent hole.
const slotKeys = new Set(
  sorted.flatMap((m) => m.data.personas.map((p) => `${m.id}::${p}`)),
);
for (const o of unboundTakes(slotKeys)) {
  console.warn(
    `[unaiverse] take binds to no slot: "${o.milestoneId}" / "${o.persona}" — check the id and persona spelling`,
  );
}
---

<Base>
  <header class="hero">
    <div class="wrap">
      <p class="hero__kicker mono">A totally unofficial field guide</p>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__tagline">{SITE.tagline}</p>
      <p class="hero__blurb">
        For roughly 77 years the United Nations was busy with minor side quests — peace,
        human rights, development — and mentioned artificial intelligence approximately
        never. Then a chatbot launched in November 2022. Here is everything that happened
        next, with receipts.
      </p>

      <dl class="hero__stats">
        <div><dt>Milestones</dt><dd>{sorted.length}</dd></div>
        <div><dt>{TIERS[1].glyph} Supernova</dt><dd>{tierCounts[1]}</dd></div>
        <div><dt>{TIERS[2].glyph} Star</dt><dd>{tierCounts[2]}</dd></div>
        <div><dt>{TIERS[3].glyph} Stardust</dt><dd>{tierCounts[3]}</dd></div>
        <div><dt>Takes</dt><dd>{takes.loaded}<span class="hero__of">/{takeSlots}</span></dd></div>
      </dl>

      <p class="hero__phase">
        <strong>Phase 2 skeleton.</strong> Every milestone renders with its receipts; the
        galaxy, the Big Bang and A/BOT's dialogue arrive in Phases 4 and 5.
        {
          takes.loaded === 0
            ? ' The 156 takes are being written — their slots are live and will fill the moment the file lands.'
            : ` ${takes.loaded} of ${takes.expected} takes have landed.`
        }
      </p>
    </div>
  </header>

  <main id="timeline" class="wrap">
    {
      byZone.map(({ zone, items }) => (
        <section class="zone" aria-labelledby={`zone-${zone.id}`}>
          <div class="zone__head">
            <p class="zone__num mono">Zone {zone.id}</p>
            <h2 class="zone__title" id={`zone-${zone.id}`}>
              {zone.title}
            </h2>
            <p class="zone__range mono">{zone.range}</p>
            <p class="zone__blurb">{zone.blurb}</p>
            <p class="zone__count mono">
              {items.length} {items.length === 1 ? 'milestone' : 'milestones'}
            </p>
          </div>

          <div class="zone__nodes">
            {items.map((m) => (
              <MilestoneNode id={m.id} data={m.data} body={m.body ?? ''} />
            ))}
          </div>
        </section>
      ))
    }
  </main>

  <footer class="foot">
    <div class="wrap">
      <p>
        All facts are sourced to official UN documents. All jokes are the author's own and
        aimed strictly at hype and bureaucratic pacing — never at the Organization, its
        officials, or any Member State.
      </p>
      <p class="foot__fine">
        A personal project by Mafizul Islam. Not an official United Nations product, and
        nothing here represents the views of the UN or any of its offices. It does,
        however, link to a lot of things that do.
      </p>
    </div>
  </footer>

  <ABot />
</Base>

<style>
  .hero {
    padding: var(--sp-8) 0 var(--sp-7);
    border-bottom: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgb(0 158 219 / 0.14), transparent 70%),
      var(--void);
  }

  .hero__kicker {
    margin: 0 0 var(--sp-3);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--assembly-gold);
    font-size: var(--step--1);
  }

  .hero__title {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(100deg, var(--paper) 20%, var(--un-blue) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__tagline {
    margin-top: var(--sp-3);
    font-size: var(--step-1);
    color: var(--ink-dim);
  }

  .hero__blurb {
    margin-top: var(--sp-4);
    color: var(--ink-dim);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin: var(--sp-6) 0 var(--sp-5);
    padding: var(--sp-4) 0;
    border-block: 1px solid var(--hairline);
  }

  .hero__stats div {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .hero__stats dt {
    font-size: var(--step--1);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .hero__stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--paper);
  }

  .hero__of {
    color: var(--ink-faint);
    font-size: 0.7em;
  }

  .hero__phase {
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: var(--measure);
  }

  .hero__phase strong {
    color: var(--signal);
  }

  .zone {
    padding: var(--sp-8) 0 var(--sp-6);
    border-bottom: 1px solid var(--hairline);
  }

  .zone:last-of-type {
    border-bottom: 0;
  }

  .zone__head {
    max-width: var(--measure);
    margin-bottom: var(--sp-6);
  }

  .zone__num {
    margin: 0 0 var(--sp-2);
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--un-blue);
  }

  .zone__title {
    font-size: var(--step-2);
  }

  .zone__range {
    margin: var(--sp-2) 0 var(--sp-3);
    color: var(--assembly-gold);
    font-size: var(--step--1);
  }

  .zone__blurb {
    color: var(--ink-dim);
    font-style: italic;
  }

  .zone__count {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  /* The spine. Phase 4 replaces this with the galaxy; the vertical
     timeline stays as the reduced-motion and mobile fallback. */
  .zone__nodes {
    position: relative;
    display: grid;
    gap: var(--sp-3);
  }

  .zone__nodes::before {
    content: '';
    position: absolute;
    left: 0.625rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--hairline-strong) 8%,
      var(--hairline-strong) 92%,
      transparent
    );
  }

  @media (max-width: 40rem) {
    .zone__nodes::before {
      left: 0.5rem;
    }
  }

  .foot {
    padding: var(--sp-7) 0 var(--sp-8);
    border-top: 1px solid var(--hairline);
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .foot__fine {
    font-style: italic;
  }
</style>
